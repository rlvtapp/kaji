{
  "openapi": {
    "input": "./openapi.yaml",
    "name": "Notes",
    "version": "1.0.0"
  },
  "output": {
    "path": "./generated"
  },
  "packages": [
    {
      "language": "rust-cli",
      "path": "notes",
      "name": "notes-cli",
      "plugins": [

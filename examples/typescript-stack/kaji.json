{
  "$schema": "https://raw.githubusercontent.com/rlvtapp/kaji/main/schemas/v1/kaji.schema.json",
  "openapi": {
    "input": "./openapi.yaml",
    "name": "Kaji Pets",
    "version": "1.0.0"
  },
  "output": {
    "path": "./generated"
  },
  "defaults": {
    "client_style": "namespaced"
  },
  "packages": [
    {
      "language": "typescript",
      "path": "typescript/fetch",
      "name": "@example/pets",
      "plugins": [
        {
          "name": "sdk",
          "transport": "fetch",
          "surface": "client",
          "client_name": "Pets",
          "group_by_tag": true,
          "throw_on_error": true
        },
        {
          "name": "zod",
          "output": "validation"
        },
        {
          "name": "tanstack-react-query",
          "output": "react-query",
          "group_by_tag": true,
          "max_operations_per_file": 50
        },
        {
          "name": "tanstack-vue-query",
          "output": "vue-query",
          "group_by_tag": true,
          "max_operations_per_file": 50
        },
        {
          "name": "swr",
          "output": "swr",
          "group_by_tag": true,
          "max_operations_per_file": 50
        },
        {
          "name": "faker"
        },
        {
          "name": "msw",
          "output": "mocks"
        },
        {
          "name": "cypress",
          "output": "cypress"
        }
      ]
    },
    {
      "language": "typescript",
      "path": "typescript/axios",
      "name": "@example/pets-axios",
      "plugins": [
        {
          "name": "sdk",
          "transport": "axios",
          "surface": "client",
          "client_name": "Pets"
        }
      ]
    },
    {
      "language": "mock",
      "path": "mock-server",
      "plugins": [
        {
          "name": "server",
          "image": "httpmock/httpmock:0.8.0",
          "port": 4010
        }
      ]
    }
  ]
}

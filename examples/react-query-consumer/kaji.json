{
  "$schema": "https://raw.githubusercontent.com/rlvtapp/kaji/main/schemas/v1/kaji.schema.json",
  "openapi": { "input": "./openapi.yaml", "name": "Notes", "version": "1.0.0" },
  "output": { "path": "./generated" },
  "packages": [
    {
      "language": "typescript", "path": "sdk", "name": "@example/notes",
      "plugins": [
        { "name": "sdk", "transport": "fetch", "client_name": "Notes" },
        { "name": "tanstack-react-query", "output": "react-query", "clients_import": "../clients" }
      ]
    }
  ]
}

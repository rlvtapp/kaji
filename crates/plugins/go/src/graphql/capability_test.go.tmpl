package capabilities
import("capabilities/regular";"capabilities/incremental";"context";"encoding/json";"fmt";"io";"net/http";"os";"testing";"time";"errors")
func TestCapabilities(t *testing.T){
 endpoint:=os.Getenv("GRAPHQL_ENDPOINT");ctx:=context.Background()
 encode:=func(value time.Time)(json.RawMessage,error){return json.Marshal(fmt.Sprintf("wire-%d",value.Unix()))}
 decode:=func(raw json.RawMessage)(time.Time,error){var value string;if err:=json.Unmarshal(raw,&value);err!=nil{return time.Time{},err};var seconds int64;if _,err:=fmt.Sscanf(value,"wire-%d",&seconds);err!=nil{return time.Time{},err};return time.Unix(seconds,0).UTC(),nil}
 codec:=regular.TypedScalarCodec[time.Time,time.Time](encode,decode)
 client:=regular.NewClient(endpoint,nil).WithScalarCodecs(map[string]regular.ScalarCodec{"DateTime":codec});client.Headers.Set("authorization","Bearer secret")
 seven,eight,nine:=time.Unix(7,0).UTC(),time.Unix(8,0).UTC(),time.Unix(9,0).UTC()
 variables:=regular.ReadVariables{Input:regular.Filter{When:seven,List:regular.Some([]*time.Time{nil,&nine}),Next:regular.Some(regular.Filter{When:eight})},Include:false}
 result,err:=client.Read(ctx,variables);if err!=nil{t.Fatal(err)};if !result.Data.Stamp.When.Equal(seven)||result.Data.Stamp.Maybe.Set||result.Data.Stamp.List==nil||(*result.Data.Stamp.List)[0]!=nil||!(*result.Data.Stamp.List)[1].Equal(nine){t.Fatalf("nested codecs/presence: %+v",result)};if !variables.Input.When.Equal(seven){t.Fatal("mutated variables")}
 stream,err:=client.Ticks(ctx,regular.TicksVariables{Start:seven});if err!=nil{t.Fatal(err)};first,err:=stream.Next();if err!=nil||first.Data.Ticks.Name!="é"||!first.Data.Ticks.When.Equal(seven){t.Fatalf("subscription: %+v %v",first,err)};second,err:=stream.Next();var gql regular.GraphQLErrors;if !errors.As(err,&gql)||second.Data.Ticks.Maybe!=nil{t.Fatalf("partial subscription: %+v %v",second,err)};if _,err:=stream.Next();err!=io.EOF{t.Fatalf("complete: %v",err)}
 cancelled,err:=client.Ticks(ctx,regular.TicksVariables{Start:time.Unix(99,0).UTC()});if err!=nil{t.Fatal(err)};if _,err:=cancelled.Next();err!=nil{t.Fatal(err)};cancelled.Close();time.Sleep(100*time.Millisecond);stats,err:=http.Get(endpoint+"/closed");if err!=nil{t.Fatal(err)};var closed struct{Closed int};json.NewDecoder(stats.Body).Decode(&closed);stats.Body.Close();if closed.Closed<2{t.Fatal("subscription cancellation did not close generator")}
 for _,suffix:=range []string{"sse-split","sse-eof","sse-bad"}{copy:=*client;copy.Endpoint=endpoint+"/"+suffix;stream,err:=copy.Ticks(ctx,regular.TicksVariables{Start:seven});if err!=nil{t.Fatal(err)};if suffix=="sse-split"{result,err:=stream.Next();if err!=nil||result.Data.Ticks.Name!="é"{t.Fatal("fragmented SSE")};if _,err:=stream.Next();err!=io.EOF{t.Fatal(err)}}else if suffix=="sse-eof"{if _,err:=stream.Next();err!=nil{t.Fatal(err)};if _,err:=stream.Next();err==nil||err==io.EOF{t.Fatal("premature EOF accepted")}}else{if _,err:=stream.Next();err==nil{t.Fatal("unknown event accepted")}}}
 bad:=client.WithScalarCodecs(map[string]regular.ScalarCodec{"DateTime":{Encode:func(json.RawMessage)(json.RawMessage,error){return nil,fmt.Errorf("encode rejected")}}});if _,err:=bad.Read(ctx,variables);err==nil{t.Fatal("codec failure ignored")}
 bad=client.WithScalarCodecs(map[string]regular.ScalarCodec{"DateTime":{Encode:codec.Encode,Decode:func(json.RawMessage)(json.RawMessage,error){return nil,fmt.Errorf("decode rejected")}}});if _,err:=bad.Read(ctx,variables);err==nil{t.Fatal("decode failure ignored")}
 for _,suffix:=range []string{"","/plain","/invalid-path","/eof","/dialect"}{client:=incremental.NewClient(endpoint+suffix,nil).WithScalarCodecs(map[string]incremental.ScalarCodec{"DateTime":incremental.TypedScalarCodec[time.Time,time.Time](encode,decode)});client.Headers.Set("authorization","Bearer secret");stream,err:=client.Feed(ctx,incremental.FeedVariables{Count:1});if err!=nil{t.Fatal(err)};complete,failure,snapshots:=false,false,0;for{event,err:=stream.Next();if err==io.EOF{break};if err!=nil{failure=true;break};if event.Snapshot!=nil{snapshots++;if suffix==""&&snapshots==1{var data map[string]map[string]json.RawMessage;var whole map[string]json.RawMessage;json.Unmarshal(event.Snapshot.Data,&whole);json.Unmarshal(whole["user"],&data);var user map[string]json.RawMessage;json.Unmarshal(whole["user"],&user);if _,exists:=user["when"];exists{t.Fatal("partial snapshot claimed complete")}}};if event.Complete!=nil{complete=true;if !event.Complete.Data.User.When.Equal(seven)||len(event.Complete.Data.Values)!=3{t.Fatalf("incremental final: %+v",event.Complete)}}};if suffix==""||suffix=="/plain"{if !complete||failure{t.Fatalf("success incremental: %s",suffix)}}else if !failure||complete{t.Fatalf("invalid incremental accepted: %s",suffix)}}
}

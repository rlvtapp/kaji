
import (
 "bytes"
 "context"
 "encoding/json"
 "fmt"
 "io"
 "net/http"
)

// Optional distinguishes omission from explicit null. Use Some(value), Null[T](), or the zero value.
type Optional[T any] struct { Set bool; Value *T }
func Some[T any](value T) Optional[T] { return Optional[T]{Set:true,Value:&value} }
func Null[T any]() Optional[T] { return Optional[T]{Set:true} }
func (o *Optional[T]) UnmarshalJSON(data []byte) error { o.Set=true; return json.Unmarshal(data,&o.Value) }
func (o Optional[T]) MarshalJSON() ([]byte,error) {return json.Marshal(o.Value)}
type GraphQLError struct { Message string `json:"message"`; Locations []struct { Line int `json:"line"`; Column int `json:"column"` } `json:"locations,omitempty"`; Path []any `json:"path,omitempty"`; Extensions map[string]any `json:"extensions,omitempty"` }
type GraphQLErrors []GraphQLError
func (e GraphQLErrors) Error() string {if len(e)==0{return "GraphQL returned no errors"};return fmt.Sprintf("GraphQL returned %d errors: %s",len(e),e[0].Message)}
// GraphQLResponse retains partial data even when an operation also returns GraphQLErrors.
type GraphQLResponse[T any] struct { Data *T `json:"data"`; Errors GraphQLErrors `json:"errors,omitempty"`; Extensions map[string]any `json:"extensions,omitempty"` }
type HTTPError struct { StatusCode int; Body string }
func (e *HTTPError) Error() string {return fmt.Sprintf("GraphQL HTTP status %d: %s",e.StatusCode,e.Body)}
type Client struct { Endpoint string; HTTPClient *http.Client; Headers http.Header }
func NewClient(endpoint string, transport *http.Client) *Client { if transport==nil {transport=http.DefaultClient}; return &Client{Endpoint:endpoint,HTTPClient:transport,Headers:make(http.Header)} }
func execute[T any](ctx context.Context,c *Client,name,query string,variables any) (*GraphQLResponse[T],error) {
 if c==nil {return nil,fmt.Errorf("nil GraphQL client")}
 body,err:=json.Marshal(struct { Query string `json:"query"`; OperationName string `json:"operationName"`; Variables any `json:"variables"` }{query,name,variables});if err!=nil{return nil,err}
 req,err:=http.NewRequestWithContext(ctx,http.MethodPost,c.Endpoint,bytes.NewReader(body));if err!=nil{return nil,err}
 req.Header=c.Headers.Clone();if req.Header==nil {req.Header=make(http.Header)};req.Header.Set("Content-Type","application/json");req.Header.Set("Accept","application/graphql-response+json, application/json")
 transport:=c.HTTPClient;if transport==nil {transport=http.DefaultClient}
 response,err:=transport.Do(req);if err!=nil{return nil,err};defer response.Body.Close()
 data,err:=io.ReadAll(io.LimitReader(response.Body,16*1024*1024+1));if err!=nil{return nil,err};if len(data)>16*1024*1024{return nil,fmt.Errorf("GraphQL response exceeds 16 MiB")}
 result:=new(GraphQLResponse[T]);decodeErr:=json.Unmarshal(data,result)
 if response.StatusCode<200 || response.StatusCode>=300 {if decodeErr==nil{return result,&HTTPError{response.StatusCode,string(data)}};return nil,&HTTPError{response.StatusCode,string(data)}}
 if decodeErr!=nil{return nil,fmt.Errorf("invalid GraphQL response: %w",decodeErr)}
 var envelope map[string]json.RawMessage;if err=json.Unmarshal(data,&envelope);err!=nil{return nil,err}
 if _,ok:=envelope["data"];!ok && len(result.Errors)==0 {return nil,fmt.Errorf("GraphQL response contains neither data nor errors")}
 if len(result.Errors)>0{return result,result.Errors};return result,nil
}

// RetryConfig controls safe retries performed by the generated client.
// A nil ClientConfig.Retry uses three attempts, a 250ms initial delay, and an
// 8s maximum delay. Set MaxAttempts to 1 to make requests single-attempt.
type RetryConfig struct {
	MaxAttempts  int
	InitialDelay time.Duration
	MaxDelay     time.Duration
}

// PoolsterRequestInfo is safe request metadata for lifecycle hooks. Request
// headers and bodies are deliberately omitted so observability integrations do
// not accidentally receive credentials or customer data.
type PoolsterRequestInfo struct {
	Method string
	URL    string
}

// PoolsterResponseInfo describes the final HTTP response observed by a request.
// Intermediate retry responses are intentionally not reported.
type PoolsterResponseInfo struct {
	Request    PoolsterRequestInfo
	StatusCode int
	Headers    http.Header
}

// PoolsterClientHooks receives lifecycle events for one logical generated SDK
// request. BeforeRequest, AfterResponse, and OnError run at most once each;
// retries remain an implementation detail of the transport.
type PoolsterClientHooks interface {
	BeforeRequest(PoolsterRequestInfo)
	AfterResponse(PoolsterResponseInfo)
	OnError(PoolsterRequestInfo, error)
}

func (client *Client) beforeRequest(request PoolsterRequestInfo) {
	if client.hooks != nil {
		client.hooks.BeforeRequest(request)
	}
}

func (client *Client) afterResponse(request PoolsterRequestInfo, response *http.Response) {
	if client.hooks != nil {
		client.hooks.AfterResponse(PoolsterResponseInfo{Request: request, StatusCode: response.StatusCode, Headers: response.Header.Clone()})
	}
}

func (client *Client) onError(request PoolsterRequestInfo, err error) {
	if client.hooks != nil {
		client.hooks.OnError(request, err)
	}
}

type retryConfig struct {
	maxAttempts  int
	initialDelay time.Duration
	maxDelay     time.Duration
}

func normalizeRetry(config *RetryConfig) retryConfig {
	result := retryConfig{maxAttempts: 3, initialDelay: 250 * time.Millisecond, maxDelay: 8 * time.Second}
	if config == nil {
		return result
	}
	if config.MaxAttempts > 0 {
		result.maxAttempts = config.MaxAttempts
	}
	if config.InitialDelay > 0 {
		result.initialDelay = config.InitialDelay
	}
	if config.MaxDelay > 0 {
		result.maxDelay = config.MaxDelay
	}
	if result.maxDelay < result.initialDelay {
		result.maxDelay = result.initialDelay
	}
	return result
}

func canRetry(request *http.Request) bool {
	switch request.Method {
	case http.MethodGet, http.MethodHead, http.MethodOptions, http.MethodTrace, "QUERY", http.MethodPut, http.MethodDelete:
		return true
	case http.MethodPost, http.MethodPatch:
		return strings.TrimSpace(request.Header.Get("Idempotency-Key")) != ""
	default:
		return false
	}
}

func isRetryableStatus(status int) bool {
	switch status {
	case http.StatusRequestTimeout, http.StatusTooManyRequests, http.StatusInternalServerError,
		http.StatusBadGateway, http.StatusServiceUnavailable, http.StatusGatewayTimeout:
		return true
	default:
		return false
	}
}

func (config retryConfig) delay(response *http.Response, attempt int) time.Duration {
	if response != nil {
		if milliseconds, ok := parseRetryAfterMilliseconds(response.Header.Get("Retry-After-Ms")); ok {
			if milliseconds > config.maxDelay {
				return config.maxDelay
			}
			return milliseconds
		}
		if retryAfter, ok := parseRetryAfter(response.Header.Get("Retry-After")); ok {
			if retryAfter > config.maxDelay {
				return config.maxDelay
			}
			return retryAfter
		}
	}
	delay := config.initialDelay
	for retry := 1; retry < attempt && delay < config.maxDelay; retry++ {
		if delay > config.maxDelay/2 {
			return config.maxDelay
		}
		delay *= 2
	}
	return delay
}

func parseRetryAfterMilliseconds(value string) (time.Duration, bool) {
	value = strings.TrimSpace(value)
	if value == "" || value[0] < '0' || value[0] > '9' || value[len(value)-1] < '0' || value[len(value)-1] > '9' {
		return 0, false
	}
	dots := 0
	for _, ch := range value {
		if ch == '.' {
			dots++
			if dots > 1 {
				return 0, false
			}
			continue
		}
		if ch < '0' || ch > '9' {
			return 0, false
		}
	}
	milliseconds, err := strconv.ParseFloat(value, 64)
	if err != nil || milliseconds < 0 {
		return 0, false
	}
	if milliseconds >= float64(1<<63-1)/float64(time.Millisecond) {
		return time.Duration(1<<63 - 1), true
	}
	return time.Duration(milliseconds * float64(time.Millisecond)), true
}

func parseRetryAfter(value string) (time.Duration, bool) {
	if seconds, err := strconv.Atoi(strings.TrimSpace(value)); err == nil && seconds >= 0 {
		if int64(seconds) > (1<<63-1)/int64(time.Second) {
			return time.Duration(1<<63 - 1), true
		}
		return time.Duration(seconds) * time.Second, true
	}
	if when, err := http.ParseTime(value); err == nil {
		if delay := time.Until(when); delay > 0 {
			return delay, true
		}
	}
	return 0, false
}

func waitForRetry(ctx context.Context, delay time.Duration) error {
	timer := time.NewTimer(delay)
	defer timer.Stop()
	select {
	case <-ctx.Done():
		return ctx.Err()
	case <-timer.C:
		return nil
	}
}

func replayRequest(request *http.Request) (*http.Request, error) {
	retry := request.Clone(request.Context())
	if request.GetBody == nil {
		if request.Body == nil || request.Body == http.NoBody {
			return retry, nil
		}
		return nil, fmt.Errorf("poolster: cannot retry a request whose body cannot be replayed")
	}
	body, err := request.GetBody()
	if err != nil {
		return nil, fmt.Errorf("poolster: replay request body: %w", err)
	}
	retry.Body = body
	return retry, nil
}

func (client *Client) doWithRetry(request *http.Request, destination any) error {
	retryAllowed := canRetry(request)
	requestInfo := PoolsterRequestInfo{Method: request.Method, URL: request.URL.String()}
	client.beforeRequest(requestInfo)
	authRefreshed := false
	managedAuth := client.tokenProvider != nil && request.Header.Get("Authorization") == ""
	authToken := ""
	if managedAuth {
		var err error
		authToken, err = client.tokenProvider.Token(request.Context(), "")
		if err != nil {
			client.onError(requestInfo, err)
			return err
		}
		if strings.TrimSpace(authToken) == "" {
			err = fmt.Errorf("poolster: token provider returned an empty token")
			client.onError(requestInfo, err)
			return err
		}
		request.Header.Set("Authorization", "Bearer "+authToken)
	}
	for attempt := 1; ; attempt++ {
		if err := request.Context().Err(); err != nil {
			client.onError(requestInfo, err)
			return err
		}
		response, err := client.httpClient.Do(request)
		if err != nil {
			if !retryAllowed || attempt >= client.retry.maxAttempts || request.Context().Err() != nil {
				result := fmt.Errorf("poolster: execute request: %w", err)
				client.onError(requestInfo, result)
				return result
			}
			if err := waitForRetry(request.Context(), client.retry.delay(nil, attempt)); err != nil {
				result := fmt.Errorf("poolster: execute request: %w", err)
				client.onError(requestInfo, result)
				return result
			}
			request, err = replayRequest(request)
			if err != nil {
				client.onError(requestInfo, err)
				return err
			}
			continue
		}

		if response.StatusCode == http.StatusUnauthorized && managedAuth && retryAllowed && !authRefreshed {
			response.Body.Close()
			request, err = replayRequest(request)
			if err != nil {
				client.onError(requestInfo, err)
				return err
			}
			authRefreshed = true
			authToken, err = client.tokenProvider.Token(request.Context(), authToken)
			if err != nil {
				client.onError(requestInfo, err)
				return err
			}
			if strings.TrimSpace(authToken) == "" {
				err = fmt.Errorf("poolster: token provider returned an empty token")
				client.onError(requestInfo, err)
				return err
			}
			request.Header.Set("Authorization", "Bearer "+authToken)
			attempt-- // A single safe auth refresh has its own bounded replay budget.
			continue
		}

		if response.StatusCode >= http.StatusOK && response.StatusCode < http.StatusMultipleChoices {
			defer response.Body.Close()
			client.afterResponse(requestInfo, response)
			if destination == nil || response.StatusCode == http.StatusNoContent {
				return nil
			}
			if bytesDestination, ok := destination.(*[]byte); ok {
				body, err := io.ReadAll(response.Body)
				if err != nil {
					result := fmt.Errorf("poolster: read binary response: %w", err)
					client.onError(requestInfo, result)
					return result
				}
				*bytesDestination = body
				return nil
			}
			if textDestination, ok := destination.(*string); ok && !strings.Contains(response.Header.Get("Content-Type"), "json") {
				body, err := io.ReadAll(response.Body)
				if err != nil {
					result := fmt.Errorf("poolster: read text response: %w", err)
					client.onError(requestInfo, result)
					return result
				}
				*textDestination = string(body)
				return nil
			}
			decode := client.decodeResponse
			if poolsterSequentialMedia(response.Header.Get("Content-Type")) {
				decode = func(body io.Reader, destination any) error {
					return client.decodeSequentialResponse(body, response.Header.Get("Content-Type"), destination)
				}
			}
			if err := decode(response.Body, destination); err != nil {
				result := fmt.Errorf("poolster: decode response: %w", err)
				client.onError(requestInfo, result)
				return result
			}
			return nil
		}

		if retryAllowed && isRetryableStatus(response.StatusCode) && attempt < client.retry.maxAttempts {
			delay := client.retry.delay(response, attempt)
			response.Body.Close()
			if err := waitForRetry(request.Context(), delay); err != nil {
				result := fmt.Errorf("poolster: execute request: %w", err)
				client.onError(requestInfo, result)
				return result
			}
			request, err = replayRequest(request)
			if err != nil {
				client.onError(requestInfo, err)
				return err
			}
			continue
		}

		body, _ := io.ReadAll(io.LimitReader(response.Body, 1<<20))
		client.afterResponse(requestInfo, response)
		response.Body.Close()
		result := &poolsterAPIError{StatusCode: response.StatusCode, Body: body, ContentType: response.Header.Get("Content-Type")}
		client.onError(requestInfo, result)
		return result
	}
}

// stream returns an open Server-Sent Events response body. Callers must close it.
// It uses the same retry policy before the stream is established; once bytes are
// flowing, reconnect policy belongs to the consuming application.
func (client *Client) stream(request *http.Request) (io.ReadCloser, error) {
	retryAllowed := canRetry(request)
	requestInfo := PoolsterRequestInfo{Method: request.Method, URL: request.URL.String()}
	client.beforeRequest(requestInfo)
	for attempt := 1; ; attempt++ {
		if err := request.Context().Err(); err != nil {
			client.onError(requestInfo, err)
			return nil, err
		}
		response, err := client.httpClient.Do(request)
		if err != nil {
			if !retryAllowed || attempt >= client.retry.maxAttempts || request.Context().Err() != nil {
				result := fmt.Errorf("poolster: execute request: %w", err)
				client.onError(requestInfo, result)
				return nil, result
			}
			if err := waitForRetry(request.Context(), client.retry.delay(nil, attempt)); err != nil {
				result := fmt.Errorf("poolster: execute request: %w", err)
				client.onError(requestInfo, result)
				return nil, result
			}
			request, err = replayRequest(request)
			if err != nil {
				client.onError(requestInfo, err)
				return nil, err
			}
			continue
		}
		if response.StatusCode >= http.StatusOK && response.StatusCode < http.StatusMultipleChoices {
			client.afterResponse(requestInfo, response)
			return response.Body, nil
		}
		if retryAllowed && isRetryableStatus(response.StatusCode) && attempt < client.retry.maxAttempts {
			delay := client.retry.delay(response, attempt)
			response.Body.Close()
			if err := waitForRetry(request.Context(), delay); err != nil {
				result := fmt.Errorf("poolster: execute request: %w", err)
				client.onError(requestInfo, result)
				return nil, result
			}
			request, err = replayRequest(request)
			if err != nil {
				client.onError(requestInfo, err)
				return nil, err
			}
			continue
		}
		body, _ := io.ReadAll(io.LimitReader(response.Body, 1<<20))
		client.afterResponse(requestInfo, response)
		response.Body.Close()
		result := &poolsterAPIError{StatusCode: response.StatusCode, Body: body, ContentType: response.Header.Get("Content-Type")}
		client.onError(requestInfo, result)
		return nil, result
	}
}

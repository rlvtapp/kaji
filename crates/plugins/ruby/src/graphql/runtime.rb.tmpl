  INPUT_CLASSES = {}
  class Model
    @registry = {}
    def self.register(type, klass); Model.instance_variable_get(:@registry)[type['model_class']] = klass; end
    def initialize(type, value, input)
      value = value.to_h if value.is_a?(Model)
      value = value.transform_keys(&:to_s) if value.is_a?(Hash)
      @value = self.class.validate(type, value, input, false)
    end
    def present?(key); @value.key?(key.to_s); end
    def self.wire(value)
      case value
      when Model then value.to_h
      when Hash then value.transform_values { |item| wire(item) }
      when Array then value.map { |item| wire(item) }
      else value
      end
    end
    def to_h; Model.wire(@value); end
    def self.validate(type, value, input, wrap = true)
      value = value.to_h if value.is_a?(Model)
      return nil if value.nil? && type['nullable']
      raise ArgumentError, 'Unexpected null' if value.nil?
      kind = type['kind']
      tag, argument = kind.first
      case tag
      when 'Named'
        klass = INPUT_CLASSES.fetch(argument)
        klass.new(value)
      when 'Object'
        raise ArgumentError, 'Expected object' unless value.is_a?(Hash)
        value = value.transform_keys(&:to_s)
        fields = argument.to_h { |field| [field['name'], field] }
        raise ArgumentError, 'Unknown input field' if input && (value.keys - fields.keys).any?
        result = fields.each_with_object({}) do |(name, field), result|
          if value.key?(name)
            result[name] = validate(field['ty'], value[name], input)
          elsif !field['optional']
            raise ArgumentError, "Missing required field #{name}"
          end
        end
        klass = Model.instance_variable_get(:@registry)[type['model_class']]
        wrap && klass ? klass.new(result) : result
      when 'List'
        raise ArgumentError, 'Expected array' unless value.is_a?(Array)
        value.map { |item| validate(argument, item, input) }
      when 'Enum', 'Literal'
        allowed = tag == 'Literal' ? [argument] : argument
        raise ArgumentError, 'Unknown enum/discriminator value' unless allowed.include?(value)
        value
      when 'Union'
        variants = argument.filter_map do |variant|
          begin; validate(variant, value, input); rescue ArgumentError; nil; end
        end
        raise ArgumentError, 'Unrecognized or ambiguous selected variant' unless variants.length == 1
        variants.first
      when 'Scalar'
        valid = case argument
        when 'String' then value.is_a?(String)
        when 'ID' then value.is_a?(String) || (input && value.is_a?(Integer))
        when 'Int' then value.is_a?(Integer) && (-2147483648..2147483647).include?(value)
        when 'Float' then value.is_a?(Numeric)
        when 'Boolean' then value == true || value == false
        else true
        end
        raise ArgumentError, "Invalid scalar #{argument}" unless valid
        argument == 'Float' ? value.to_f : (argument == 'ID' ? value.to_s : value)
      else raise ArgumentError, 'Unsupported model kind'
      end
    end
  end
  class GraphqlErrors < StandardError
    attr_reader :errors, :data
    def initialize(errors, data); super('GraphQL response contains errors'); @errors, @data = errors, data; end
  end
  GraphqlResponse = Struct.new(:data, :errors, :extensions, :data_present, keyword_init: true) do
    def status; errors.any? ? (data.nil? ? :error : :partial) : :success; end
    def require_data
      raise GraphqlErrors.new(errors, data) if errors.any?
      raise ArgumentError, 'GraphQL response has no data' if data.nil?
      data
    end
  end
  class HttpError < StandardError
    attr_reader :status, :response
    def initialize(status, response); super("GraphQL HTTP status #{status}"); @status, @response = status, response; end
  end
  class Transport
    def initialize(endpoint, headers: {}, timeout: 30, scalar_codecs: {}, max_frame_bytes: 1048576)
      @uri = URI(endpoint)
      raise ArgumentError, 'GraphQL endpoint must be HTTP(S)' unless %w[http https].include?(@uri.scheme)
      raise ArgumentError, 'Positive timeout required' unless timeout.is_a?(Numeric) && timeout > 0
      raise ArgumentError, 'Invalid HTTP headers' unless headers.is_a?(Hash) && headers.all? { |key, value| key.is_a?(String) && value.is_a?(String) && !key.match?(/[\r\n]/) && !value.match?(/[\r\n]/) }
      raise ArgumentError, 'Positive frame limit required' unless max_frame_bytes.is_a?(Integer) && max_frame_bytes > 0
      @headers, @timeout, @scalar_codecs, @max_frame_bytes = headers, timeout, scalar_codecs, max_frame_bytes
    end
    def execute(document, operation, variables, result_type, variables_type: nil)
      request = Net::HTTP::Post.new(@uri)
      request['Content-Type'] = 'application/json'
      request['Accept'] = 'application/graphql-response+json, application/json'
      @headers.each { |key, value| request[key] = value }
      request.body = JSON.generate(query: document, operationName: operation, variables: scalar_walk(variables, variables_type, :encode))
      raw = Net::HTTP.start(@uri.host, @uri.port, use_ssl: @uri.scheme == 'https', open_timeout: @timeout, read_timeout: @timeout) { |http| http.request(request) }
      response = response(JSON.parse(raw.body), result_type)
      raise HttpError.new(raw.code.to_i, response) unless (200..299).include?(raw.code.to_i)
      response
    end
    def response(value, result_type)
      raise ArgumentError, 'Invalid GraphQL envelope' unless value.is_a?(Hash) && (value.key?('data') || value.key?('errors'))
      errors = value.fetch('errors', [])
      raise ArgumentError, 'Invalid GraphQL errors' unless errors.is_a?(Array) && errors.all? { |e| e.is_a?(Hash) && e['message'].is_a?(String) }
      raise ArgumentError, 'GraphQL response has neither data nor errors' unless value.key?('data') || errors.any?
      data = value['data'].nil? ? nil : result_type.new(scalar_walk(value['data'], result_type::TYPE, :decode))
      response = GraphqlResponse.new(data: data, errors: errors, extensions: value['extensions'], data_present: value.key?('data'))
      response
    end
  end

public struct GraphqlScalarCodec {
  public let encode: (GraphqlJSON) throws -> GraphqlJSON
  public let decode: (GraphqlJSON) throws -> GraphqlJSON
  public init(
    encode: @escaping (GraphqlJSON) throws -> GraphqlJSON,
    decode: @escaping (GraphqlJSON) throws -> GraphqlJSON
  ) {
    self.encode = encode
    self.decode = decode
  }
}
public struct GraphqlProtocolError: Error { public let message: String }
public struct GraphqlIncrementalSnapshot<T: Decodable> {
  public let data: GraphqlJSON?
  public let errors: [GraphqlError]
  public let extensions: GraphqlJSON?
  public let patches: [GraphqlJSON]
  public let complete: Bool
  public func decodeData() throws -> T {
    guard complete, errors.isEmpty, let data = data else {
      throw GraphqlProtocolError(message: "Incomplete or failed incremental result")
    }
    return try JSONDecoder().decode(T.self, from: JSONEncoder().encode(data))
  }
}
private func protocolError(_ message: String) -> GraphqlProtocolError {
  GraphqlProtocolError(message: message)
}
private func jsonObject(_ json: GraphqlJSON) throws -> [String: GraphqlJSON] {
  guard case .object(let object) = json else { throw protocolError("Expected JSON object") }
  return object
}
private func jsonString(_ json: GraphqlJSON?) throws -> String {
  guard case .string(let text)? = json else { throw protocolError("Expected JSON string") }
  return text
}
private func scalarMatches(_ value: GraphqlJSON?, _ shape: GraphqlJSON) -> Bool {
  guard case .object(let object) = shape else { return true }
  if case .string(let expected)? = object["literal"] {
    if case .string(let actual)? = value { return actual == expected }
    return false
  }
  if case .array(let fields)? = object["fields"], case .object(let data)? = value {
    for field in fields {
      if case .array(let pair) = field, pair.count == 2, case .object(let child) = pair[1],
        child["literal"] != nil
      {
        guard case .string(let key) = pair[0], scalarMatches(data[key], pair[1]) else {
          return false
        }
      }
    }
  }
  return true
}
private func scalarTransform(
  _ value: GraphqlJSON, _ shape: GraphqlJSON, _ inputs: [String: GraphqlJSON],
  _ codecs: [String: GraphqlScalarCodec], _ encode: Bool
) throws -> GraphqlJSON {
  if case .null = value { return value }
  guard case .object(let descriptor) = shape else { return value }
  if case .string(let name)? = descriptor["scalar"], let codec = codecs[name] {
    let result = try encode ? codec.encode(value) : codec.decode(value)
    if case .null = result { throw protocolError("Scalar codec returned null") }
    return result
  }
  if case .string(let name)? = descriptor["named"], let named = inputs[name] {
    return try scalarTransform(value, named, inputs, codecs, encode)
  }
  if let item = descriptor["list"] {
    guard case .array(let values) = value else { throw protocolError("Expected codec list") }
    return .array(try values.map { try scalarTransform($0, item, inputs, codecs, encode) })
  }
  if case .array(let variants)? = descriptor["union"] {
    guard let variant = variants.first(where: { scalarMatches(value, $0) }) else {
      throw protocolError("Unknown codec discriminator")
    }
    return try scalarTransform(value, variant, inputs, codecs, encode)
  }
  if case .array(let fields)? = descriptor["fields"] {
    var data = try jsonObject(value)
    for field in fields {
      guard case .array(let pair) = field, pair.count == 2 else {
        throw protocolError("Invalid codec descriptor")
      }
      let key = try jsonString(pair[0])
      if let child = data[key] {
        data[key] = try scalarTransform(child, pair[1], inputs, codecs, encode)
      }
    }
    return .object(data)
  }
  return value
}
private final class GraphqlStreamingDelegate: NSObject, URLSessionDataDelegate, @unchecked Sendable
{
  let continuation: AsyncThrowingStream<Data, Error>.Continuation
  let mediaType: String
  var session: URLSession?
  init(_ continuation: AsyncThrowingStream<Data, Error>.Continuation, _ mediaType: String) {
    self.continuation = continuation
    self.mediaType = mediaType
  }
  func urlSession(
    _ session: URLSession, dataTask: URLSessionDataTask, didReceive response: URLResponse,
    completionHandler: @escaping (URLSession.ResponseDisposition) -> Void
  ) {
    guard let http = response as? HTTPURLResponse, (200...299).contains(http.statusCode),
      http.value(forHTTPHeaderField: "Content-Type")?.lowercased().hasPrefix(mediaType) == true
        || mediaType == "multipart/mixed"
          && (http.value(forHTTPHeaderField: "Content-Type")?.lowercased().hasPrefix(
            "application/json") == true
            || http.value(forHTTPHeaderField: "Content-Type")?.lowercased().hasPrefix(
              "application/graphql-response+json") == true)
    else {
      continuation.finish(throwing: protocolError("Invalid streaming response"))
      completionHandler(.cancel)
      return
    }
    // Header is delivered separately as a compact UTF-8 control line.
    continuation.yield(
      Data(("content-type:" + (http.value(forHTTPHeaderField: "Content-Type") ?? "") + "\n").utf8))
    completionHandler(.allow)
  }
  func urlSession(_ session: URLSession, dataTask: URLSessionDataTask, didReceive data: Data) {
    continuation.yield(data)
  }
  func urlSession(_ session: URLSession, task: URLSessionTask, didCompleteWithError error: Error?) {
    if let error = error { continuation.finish(throwing: error) } else { continuation.finish() }
    session.finishTasksAndInvalidate()
    self.session = nil
  }
}
private final class GraphqlStreamState: @unchecked Sendable {
  var session: URLSession?
  var task: Task<Void, Never>?
}
private func streamLines(
  _ request: URLRequest, _ configuration: URLSessionConfiguration, _ mediaType: String
) -> (stream: AsyncThrowingStream<String, Error>, cancel: @Sendable () -> Void) {
  let state = GraphqlStreamState()
  let stream = AsyncThrowingStream<String, Error> { output in
    let bytes = AsyncThrowingStream<Data, Error> { continuation in
      let handler = GraphqlStreamingDelegate(continuation, mediaType)
      let session = URLSession(configuration: configuration, delegate: handler, delegateQueue: nil)
      handler.session = session
      state.session = session
      let task = session.dataTask(with: request)
      continuation.onTermination = { _ in
        task.cancel()
        session.invalidateAndCancel()
      }
      task.resume()
    }
    let task = Task {
      do {
        var buffer = Data()
        for try await chunk in bytes {
          buffer.append(chunk)
          if buffer.count > 8 * 1024 * 1024 { throw protocolError("Streaming line exceeds limit") }
          while let newline = buffer.firstIndex(of: 10) {
            let part = buffer[..<newline]
            guard let text = String(data: part, encoding: .utf8) else {
              throw protocolError("Invalid stream UTF-8")
            }
            output.yield(text.hasSuffix("\r") ? String(text.dropLast()) : text)
            buffer.removeSubrange(...newline)
          }
        }
        if !buffer.isEmpty {
          guard let text = String(data: buffer, encoding: .utf8) else {
            throw protocolError("Invalid stream UTF-8")
          }
          output.yield(text)
        }
        output.finish()
      } catch { output.finish(throwing: error) }
    }
    state.task = task
    output.onTermination = { _ in
      task.cancel()
      state.session?.invalidateAndCancel()
    }
  }
  return (
    stream,
    {
      state.task?.cancel()
      state.session?.invalidateAndCancel()
    }
  )
}
extension GraphqlClient {
  private func request<V: Encodable>(
    _ operation: String, _ document: String, _ variables: V, _ accept: String,
    _ variableShape: String, _ inputs: String
  ) throws -> URLRequest {
    var request = URLRequest(url: endpoint)
    request.httpMethod = "POST"
    for (name, value) in headers { request.setValue(value, forHTTPHeaderField: name) }
    request.setValue("application/json", forHTTPHeaderField: "Content-Type")
    request.setValue(accept, forHTTPHeaderField: "Accept")
    let values = try JSONDecoder().decode(GraphqlJSON.self, from: JSONEncoder().encode(variables))
    let shape = try JSONDecoder().decode(GraphqlJSON.self, from: Data(variableShape.utf8))
    let definitions = try jsonObject(
      JSONDecoder().decode(GraphqlJSON.self, from: Data(inputs.utf8)))
    request.httpBody = try JSONEncoder().encode(
      GraphqlRequest(
        query: document, operationName: operation,
        variables: scalarTransform(values, shape, definitions, scalarCodecs, true)))
    return request
  }
  private func decoded<T: Decodable>(
    _ payload: GraphqlJSON, _ resultShape: String, _ inputs: String, _ resultType: T.Type
  ) throws -> GraphqlResponse<T> {
    var envelope = try jsonObject(payload)
    guard envelope["data"] != nil || envelope["errors"] != nil, envelope["hasNext"] == nil,
      envelope["incremental"] == nil
    else {
      throw DecodingError.dataCorrupted(
        .init(codingPath: [], debugDescription: "Invalid GraphQL envelope"))
    }
    _ = try validatedErrors(envelope["errors"])
    if let data = envelope["data"] { envelope["data"] = try transformed(data, resultShape, inputs) }
    return try JSONDecoder().decode(
      GraphqlResponse<T>.self, from: JSONEncoder().encode(GraphqlJSON.object(envelope)))
  }
  private func transformed(_ data: GraphqlJSON, _ shape: String, _ inputs: String) throws
    -> GraphqlJSON
  {
    try scalarTransform(
      data, JSONDecoder().decode(GraphqlJSON.self, from: Data(shape.utf8)),
      jsonObject(JSONDecoder().decode(GraphqlJSON.self, from: Data(inputs.utf8))), scalarCodecs,
      false)
  }
  public func executeWithScalars<T: Decodable, V: Encodable>(
    operationName: String, document: String, variables: V, resultType: T.Type,
    variableShape: String, resultShape: String, inputs: String
  ) async throws -> GraphqlResponse<T> {
    let request = try request(
      operationName, document, variables, "application/graphql-response+json, application/json",
      variableShape, inputs)
    let (data, response) = try await session.data(for: request)
    guard let http = response as? HTTPURLResponse else { throw URLError(.badServerResponse) }
    guard (200...299).contains(http.statusCode) else {
      throw GraphqlHTTPError(statusCode: http.statusCode, body: data)
    }
    return try decoded(
      JSONDecoder().decode(GraphqlJSON.self, from: data), resultShape, inputs, resultType)
  }
  public func subscribe<T: Decodable, V: Encodable>(
    operationName: String, document: String, variables: V, resultType: T.Type,
    variableShape: String, resultShape: String, inputs: String
  ) async throws -> AsyncThrowingStream<GraphqlResponse<T>, Error> {
    let request = try request(
      operationName, document, variables, "text/event-stream", variableShape, inputs)
    return AsyncThrowingStream { output in
      let task = Task {
        do {
          let connection = streamLines(request, session.configuration, "text/event-stream")
          defer { connection.cancel() }
          var first = true
          var event = ""
          var data = ""
          for try await line in connection.stream {
            if first {
              first = false
              continue
            }
            if line.isEmpty {
              if event == "complete" {
                output.finish()
                return
              }
              if event.isEmpty && data.isEmpty { continue }
              guard event == "next" else { throw protocolError("Unsupported SSE event") }
              output.yield(
                try decoded(
                  JSONDecoder().decode(GraphqlJSON.self, from: Data(data.utf8)), resultShape,
                  inputs, resultType))
              event = ""
              data = ""
              continue
            }
            if line.hasPrefix(":") { continue }
            let parts = line.split(separator: ":", maxSplits: 1, omittingEmptySubsequences: false)
            let value =
              parts.count > 1
              ? (parts[1].hasPrefix(" ") ? String(parts[1].dropFirst()) : String(parts[1])) : ""
            if parts[0] == "event" {
              event = value
            } else if parts[0] == "data" {
              if !data.isEmpty { data += "\n" }
              data += value
            }
            if data.utf8.count > 8 * 1024 * 1024 { throw protocolError("SSE event exceeds limit") }
          }
          throw protocolError("SSE ended before complete")
        } catch { output.finish(throwing: error) }
      }
      output.onTermination = { _ in task.cancel() }
    }
  }
  public func incremental<T: Decodable, V: Encodable>(
    operationName: String, document: String, variables: V, resultType: T.Type,
    variableShape: String, resultShape: String, inputs: String
  ) async throws -> AsyncThrowingStream<GraphqlIncrementalSnapshot<T>, Error> {
    let request = try request(
      operationName, document, variables, "multipart/mixed;deferSpec=20220824", variableShape,
      inputs)
    return AsyncThrowingStream { output in
      let task = Task {
        do {
          let connection = streamLines(request, session.configuration, "multipart/mixed")
          defer { connection.cancel() }
          var jsonFallback = false
          var header = true
          var marker: String?
          var started = false
          var json = false
          var readingHeaders = true
          var content = ""
          var data: GraphqlJSON?
          var errors: [GraphqlError] = []
          var extensions: GraphqlJSON?
          for try await line in connection.stream {
            if header {
              header = false
              let type = String(line.dropFirst("content-type:".count))
              if type.lowercased().hasPrefix("application/json")
                || type.lowercased().hasPrefix("application/graphql-response+json")
              {
                jsonFallback = true
                continue
              }
              let parameters = type.split(separator: ";").dropFirst().map {
                $0.trimmingCharacters(in: .whitespaces)
              }
              for parameter in parameters {
                let pair = parameter.split(separator: "=", maxSplits: 1).map {
                  String($0).trimmingCharacters(in: CharacterSet(charactersIn: "\" "))
                }
                if pair.count == 2 {
                  if pair[0].lowercased() == "deferspec" && pair[1] != "20220824"
                    || pair[0].lowercased() == "incrementalspec"
                  {
                    throw protocolError("Unsupported incremental dialect")
                  }
                  if pair[0].lowercased() == "boundary" {
                    guard !pair[1].isEmpty, pair[1].count <= 70 else {
                      throw protocolError("Invalid multipart boundary")
                    }
                    marker = "--" + pair[1]
                  }
                }
              }
              guard marker != nil else { throw protocolError("Missing multipart boundary") }
              continue
            }
            if jsonFallback {
              content += line + "\n"
              if content.utf8.count > 8 * 1024 * 1024 {
                throw protocolError("JSON fallback exceeds limit")
              }
              continue
            }
            guard let boundary = marker else { throw protocolError("Missing boundary") }
            if !started {
              guard line == boundary else { throw protocolError("Invalid initial boundary") }
              started = true
              continue
            }
            if readingHeaders {
              if line.isEmpty {
                guard json else { throw protocolError("Multipart part requires JSON") }
                readingHeaders = false
              } else if line.lowercased() == "content-type: application/json" {
                json = true
              }
              continue
            }
            if line == boundary || line == boundary + "--" {
              let payload = try jsonObject(
                JSONDecoder().decode(GraphqlJSON.self, from: Data(content.utf8)))
              guard payload["pending"] == nil, payload["completed"] == nil,
                case .bool(let hasNext)? = payload["hasNext"]
              else { throw protocolError("Unsupported incremental envelope") }
              if data == nil && errors.isEmpty {
                guard payload["incremental"] == nil,
                  payload["data"] != nil || payload["errors"] != nil
                else { throw protocolError("Invalid initial envelope") }
                data = payload["data"]
              } else if payload["data"] != nil {
                throw protocolError("Repeated initial data")
              }
              errors += try validatedErrors(payload["errors"])
              if let value = payload["extensions"] { extensions = value }
              var patches: [GraphqlJSON] = []
              if let incremental = payload["incremental"] {
                guard case .array(let items) = incremental, !items.isEmpty else {
                  throw protocolError("Invalid incremental patches")
                }
                for patch in items {
                  data = try mergePatch(data, patch)
                  let object = try jsonObject(patch)
                  errors += try validatedErrors(object["errors"])
                  patches.append(patch)
                }
              }
              let closed = line == boundary + "--"
              guard closed != hasNext else { throw protocolError("Completion/boundary mismatch") }
              output.yield(
                GraphqlIncrementalSnapshot<T>(
                  data: try data.map { try transformed($0, resultShape, inputs) }, errors: errors,
                  extensions: extensions, patches: patches, complete: !hasNext))
              if closed {
                output.finish()
                return
              }
              content = ""
              json = false
              readingHeaders = true
            } else {
              content += line + "\n"
              if content.utf8.count > 8 * 1024 * 1024 {
                throw protocolError("Multipart part exceeds limit")
              }
            }
          }
          if jsonFallback {
            let payload = try JSONDecoder().decode(GraphqlJSON.self, from: Data(content.utf8))
            let envelope = try jsonObject(payload)
            _ = try decoded(payload, "null", inputs, GraphqlJSON.self)
            output.yield(
              GraphqlIncrementalSnapshot<T>(
                data: try envelope["data"].map { try transformed($0, resultShape, inputs) },
                errors: try validatedErrors(envelope["errors"]), extensions: envelope["extensions"],
                patches: [], complete: true))
            output.finish()
            return
          }
          throw protocolError("Truncated incremental response")
        } catch { output.finish(throwing: error) }
      }
      output.onTermination = { _ in task.cancel() }
    }
  }
}
private func validatedErrors(_ value: GraphqlJSON?) throws -> [GraphqlError] {
  guard let value = value else { return [] }
  guard case .array(let errors) = value, !errors.isEmpty else {
    throw protocolError("Invalid GraphQL errors")
  }
  return try JSONDecoder().decode([GraphqlError].self, from: JSONEncoder().encode(value))
}
private func mergePatch(_ root: GraphqlJSON?, _ patch: GraphqlJSON) throws -> GraphqlJSON? {
  let object = try jsonObject(patch)
  guard object["id"] == nil, object["subPath"] == nil, case .array(let path)? = object["path"],
    (object["data"] != nil) != (object["items"] != nil)
  else { throw protocolError("Unsupported patch dialect") }
  func update(_ value: GraphqlJSON?, _ offset: Int) throws -> GraphqlJSON {
    if offset == path.count {
      guard let data = object["data"] else { throw protocolError("Invalid patch target") }
      if case .null = data { return .null }
      var target = try jsonObject(value ?? .null)
      for (key, child) in try jsonObject(data) {
        guard !["__proto__", "constructor", "prototype"].contains(key) else {
          throw protocolError("Unsafe property")
        }
        target[key] = child
      }
      return .object(target)
    }
    let key = path[offset]
    if case .string(let name) = key {
      guard !["__proto__", "constructor", "prototype"].contains(name) else {
        throw protocolError("Unsafe path")
      }
      var target = try jsonObject(value ?? .null)
      guard target[name] != nil else { throw protocolError("Missing patch path") }
      target[name] = try update(target[name], offset + 1)
      return .object(target)
    }
    guard case .number(let number) = key, number.isFinite, number >= 0, number.rounded() == number,
      number < Double(Int.max), case .array(var list)? = value
    else { throw protocolError("Invalid list path") }
    let index = Int(number)
    if offset == path.count - 1, let items = object["items"] {
      guard index == list.count, case .array(let additions) = items else {
        throw protocolError("Stream must append contiguous items")
      }
      list += additions
      return .array(list)
    }
    guard index < list.count else { throw protocolError("List index out of bounds") }
    list[index] = try update(list[index], offset + 1)
    return .array(list)
  }
  return try update(root, 0)
}

use crate::{graphql_runtime::{GraphqlHttpTransport,GraphqlResponse,GraphqlError,GraphqlTransportError},graphql_codecs::GraphqlShape};
use serde::{Serialize,de::DeserializeOwned};
use serde_json::{Value,Map};
use std::marker::PhantomData;
#[derive(Debug,Clone)]
pub struct GraphqlIncrementalSnapshot { pub data:Option<Value>,pub errors:Vec<GraphqlError>,pub patches:Vec<Value>,pub extensions:Option<Map<String,Value>>,pub has_next:bool }
/// Intermediate JSON is recursively partial; only Complete validates the final selected model.
#[derive(Debug)]
pub enum GraphqlIncrementalEvent<T> { Snapshot(GraphqlIncrementalSnapshot), Complete(GraphqlResponse<T>) }
pub struct GraphqlIncrementalStream<T> { response:Option<reqwest::Response>,buffer:Vec<u8>,boundary:Option<Vec<u8>>,plain:bool,started:bool,has_next:bool,finished:bool,data:Option<Value>,errors:Vec<GraphqlError>,extensions:Option<Map<String,Value>>,transport:GraphqlHttpTransport,shape:GraphqlShape,variables:Value,_result:PhantomData<T> }
impl GraphqlHttpTransport {
    pub async fn incremental_with_shape<T:DeserializeOwned,V:Serialize>(&self,document:&str,name:&str,variables:&V,shape:&str)->Result<GraphqlIncrementalStream<T>,GraphqlTransportError>{
        let shape=GraphqlShape::parse(shape)?;
        let response=self.request(document,name,variables,"multipart/mixed; deferSpec=20220824, application/graphql-response+json, application/json",Some(&shape))?.send().await.map_err(GraphqlTransportError::Network)?;
        if !response.status().is_success(){let status=response.status().as_u16();let body=response.text().await.map_err(GraphqlTransportError::Network)?;return Err(GraphqlTransportError::Http{status,body});}
        let content=response.headers().get(reqwest::header::CONTENT_TYPE).and_then(|h|h.to_str().ok()).unwrap_or("");
        let plain=matches!(content.split(';').next().unwrap_or("").trim(),"application/json"|"application/graphql-response+json");
        let boundary=if plain{None}else{
            if !content.split(';').next().unwrap_or("").trim().eq_ignore_ascii_case("multipart/mixed"){return Err(protocol("incremental response requires multipart/mixed or GraphQL JSON"));}
            let mut boundary=None;
            for parameter in content.split(';').skip(1){if let Some((key,value))=parameter.trim().split_once('='){let value=value.trim().trim_matches('"');if key.eq_ignore_ascii_case("boundary"){boundary=Some(value.as_bytes().to_vec());}else if key.eq_ignore_ascii_case("deferSpec")&&value!="20220824"{return Err(protocol("unsupported incremental dialect"));}}}
            let boundary=boundary.ok_or_else(||protocol("missing multipart boundary"))?;
            if boundary.is_empty()||boundary.len()>70||boundary.iter().any(|b|*b<0x20||*b>=0x7f){return Err(protocol("invalid multipart boundary"));}Some(boundary)
        };
        Ok(GraphqlIncrementalStream{response:Some(response),buffer:vec![],boundary,plain,started:false,has_next:true,finished:false,data:None,errors:vec![],extensions:None,transport:self.clone(),shape,variables:serde_json::to_value(variables).map_err(GraphqlTransportError::Encode)?,_result:PhantomData})
    }
}
impl<T:DeserializeOwned> GraphqlIncrementalStream<T> {
    pub async fn next(&mut self)->Result<Option<GraphqlIncrementalEvent<T>>,GraphqlTransportError>{let result=self.next_inner().await;if result.is_err(){self.response=None;self.finished=true;}result}
    async fn next_inner(&mut self)->Result<Option<GraphqlIncrementalEvent<T>>,GraphqlTransportError>{
        if self.finished{return Ok(None)}
        let part=if self.plain {
            if self.started {None}else{let bytes=self.response.take().unwrap().bytes().await.map_err(GraphqlTransportError::Network)?;if bytes.len()>1024*1024{return Err(protocol("incremental frame exceeds 1 MiB"));}Some(bytes.to_vec())}
        }else{self.part().await?};
        let Some(part)=part else{
            if !self.started||self.has_next{return Err(protocol("incremental stream ended before hasNext=false"));}
            self.finished=true;self.response=None;
            let mut envelope=Map::new();envelope.insert("data".into(),self.data.clone().unwrap_or(Value::Null));if !self.errors.is_empty(){envelope.insert("errors".into(),serde_json::to_value(&self.errors).map_err(GraphqlTransportError::Encode)?);}if let Some(extensions)=&self.extensions{envelope.insert("extensions".into(),Value::Object(extensions.clone()));}
            return self.transport.decode_envelope(Value::Object(envelope),Some(&self.shape)).map(|value|Some(GraphqlIncrementalEvent::Complete(value)));
        };
        if self.started&&!self.has_next{return Err(protocol("frame follows hasNext=false"));}
        let value:Value=serde_json::from_slice(&part).map_err(|e|protocol(&format!("invalid incremental JSON: {e}")))?;
        let object=value.as_object().ok_or_else(||protocol("incremental envelope must be an object"))?;
        if ["pending","completed","id","subPath"].iter().any(|key|object.contains_key(*key)){return Err(protocol("unsupported incremental dialect fields"));}
        self.has_next=match object.get("hasNext"){Some(Value::Bool(value))=>*value,None if self.plain=>false,_=>return Err(protocol("incremental hasNext must be boolean"))};
        if !self.started {
            let data=object.get("data");if !matches!(data,Some(Value::Object(_))|Some(Value::Null)|None){return Err(protocol("initial incremental data must be object or null"));}
            if data.is_none()&&!object.contains_key("errors"){return Err(protocol("initial incremental envelope requires data or errors"));}
            self.data=data.cloned();
        }else if object.contains_key("data"){return Err(protocol("subsequent frames must use incremental patches"));}
        append_errors(object.get("errors"),&mut self.errors)?;
        if let Some(value)=object.get("extensions"){let values=value.as_object().ok_or_else(||protocol("incremental extensions must be object"))?;self.extensions.get_or_insert_with(Map::new).extend(values.clone());}
        let patches=match object.get("incremental"){None=>vec![],Some(Value::Array(items))=>items.clone(),Some(_)=>return Err(protocol("incremental patches must be an array"))};
        for patch in &patches {self.patch(patch)?;}
        self.started=true;
        let mut data=self.data.clone();if let Some(data)=&mut data{self.transport.codecs.transform(data,&self.shape.result,&self.shape.objects,false)?;}
        Ok(Some(GraphqlIncrementalEvent::Snapshot(GraphqlIncrementalSnapshot{data,errors:self.errors.clone(),patches,extensions:self.extensions.clone(),has_next:self.has_next})))
    }
    async fn read_more(&mut self)->Result<(),GraphqlTransportError>{let chunk=self.response.as_mut().unwrap().chunk().await.map_err(GraphqlTransportError::Network)?.ok_or_else(||protocol("premature multipart EOF"))?;self.buffer.extend_from_slice(&chunk);if self.buffer.len()>1024*1024{return Err(protocol("incremental frame exceeds 1 MiB"));}Ok(())}
    async fn part(&mut self)->Result<Option<Vec<u8>>,GraphqlTransportError>{
        let marker=[b"--".as_slice(),self.boundary.as_ref().unwrap().as_slice()].concat();
        loop{if self.buffer.len()<marker.len()+2{self.read_more().await?;continue;}if !self.buffer.starts_with(&marker){return Err(protocol("invalid multipart boundary framing"));}let suffix=&self.buffer[marker.len()..];if suffix.starts_with(b"--"){self.buffer.drain(..marker.len()+2);return Ok(None)}if !suffix.starts_with(b"\r\n"){return Err(protocol("multipart boundary requires CRLF"));}self.buffer.drain(..marker.len()+2);break;}
        let headers=loop{if let Some(end)=position(&self.buffer,b"\r\n\r\n"){let value=self.buffer[..end].to_vec();self.buffer.drain(..end+4);break value;}self.read_more().await?;};
        let headers=String::from_utf8(headers).map_err(|_|protocol("invalid multipart headers"))?;
        if !headers.lines().any(|line|line.split_once(':').is_some_and(|(key,value)|key.eq_ignore_ascii_case("content-type")&&value.trim().split(';').next()==Some("application/json"))){return Err(protocol("multipart part must be application/json"));}
        let delimiter=[b"\r\n".as_slice(),marker.as_slice()].concat();
        loop{if let Some(end)=position(&self.buffer,&delimiter){let part=self.buffer[..end].to_vec();self.buffer.drain(..end+2);return Ok(Some(part));}self.read_more().await?;}
    }
    fn patch(&mut self,value:&Value)->Result<(),GraphqlTransportError>{
        let patch=value.as_object().ok_or_else(||protocol("incremental patch must be object"))?;
        if ["id","subPath","pending","completed"].iter().any(|key|patch.contains_key(*key)){return Err(protocol("unsupported incremental patch dialect"));}
        let path=patch.get("path").and_then(Value::as_array).ok_or_else(||protocol("incremental patch requires path"))?;
        if path.iter().any(|part|!part.is_string()&&part.as_u64().is_none()){return Err(protocol("invalid incremental patch path"));}
        let data=patch.get("data");let items=patch.get("items");if data.is_some()==items.is_some(){return Err(protocol("incremental patch requires exactly data or items"));}
        let selection=self.shape.selections.as_array().and_then(|selections|selections.iter().find(|selection|{
            let Some(expected)=selection["path"].as_array() else{return false};let stream=selection["kind"]=="Stream";
            if stream!=items.is_some()||path.len()!=expected.len()+usize::from(stream){return false;}
            if !expected.iter().zip(path).all(|(want,got)|want==got||(want=="*"&&got.as_u64().is_some())){return false;}
            if let Some(label)=selection["label"].as_str(){if patch.get("label").and_then(Value::as_str)!=Some(label){return false;}}
            if selection["condition"]=="Never"{return false;}
            if let Some(name)=selection["condition"]["Variable"].as_str(){if self.variables.get(name)==Some(&Value::Bool(false)){return false;}}
            true
        })).ok_or_else(||protocol("incremental patch does not match a declared selection"))?;
        let _=selection;
        append_errors(patch.get("errors"),&mut self.errors)?;
        if let Some(data)=data {if !data.is_object()&&!data.is_null(){return Err(protocol("defer data must be object or null"));}let target=at_path(self.data.as_mut().ok_or_else(||protocol("patch has no initial data"))?,path)?;if data.is_null(){*target=Value::Null;}else{let target=target.as_object_mut().ok_or_else(||protocol("defer target must be object"))?;target.extend(data.as_object().unwrap().clone());}}
        if let Some(items)=items {let items=items.as_array().ok_or_else(||protocol("stream items must be array"))?;let (index,parent)=path.split_last().ok_or_else(||protocol("stream patch requires list index"))?;let index=index.as_u64().ok_or_else(||protocol("stream index must be integer"))? as usize;let target=at_path(self.data.as_mut().ok_or_else(||protocol("patch has no initial data"))?,parent)?.as_array_mut().ok_or_else(||protocol("stream target must be list"))?;if index!=target.len(){return Err(protocol("stream patch index must append contiguously"));}target.extend(items.clone());}
        Ok(())
    }
}
fn append_errors(value:Option<&Value>,errors:&mut Vec<GraphqlError>)->Result<(),GraphqlTransportError>{if let Some(value)=value{let values:Vec<GraphqlError>=serde_json::from_value(value.clone()).map_err(|e|protocol(&format!("invalid incremental errors: {e}")))?;if values.is_empty(){return Err(protocol("incremental errors must be nonempty"));}errors.extend(values);}Ok(())}
fn at_path<'a>(mut value:&'a mut Value,path:&[Value])->Result<&'a mut Value,GraphqlTransportError>{for part in path{value=if let Some(key)=part.as_str(){value.as_object_mut().and_then(|object|object.get_mut(key))}else{part.as_u64().and_then(|index|value.as_array_mut().and_then(|array|array.get_mut(index as usize)))}.ok_or_else(||protocol("incremental patch path does not exist"))?;}Ok(value)}
fn position(bytes:&[u8],needle:&[u8])->Option<usize>{bytes.windows(needle.len()).position(|window|window==needle)}
fn protocol(message:&str)->GraphqlTransportError{GraphqlTransportError::Protocol(message.into())}

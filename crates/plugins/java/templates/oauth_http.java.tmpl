        this.driver=Objects.requireNonNull(driver);this.provider=Objects.requireNonNull(provider);this.origin=URI.create(apiOrigin);this.idempotencyHeader=idempotencyHeader;this.replayBufferedBodies=replayBufferedBodies;
        if(!Set.of("http","https").contains(origin.getScheme())||origin.getHost()==null||origin.getUserInfo()!=null||origin.getFragment()!=null||driver.followRedirects()!=Redirect.NEVER)throw new IllegalArgumentException("Invalid OAuth API origin or redirect policy");

    @Override public <T> CompletableFuture<HttpResponse<T>> sendAsync(HttpRequest request,HttpResponse.BodyHandler<T> handler,HttpResponse.PushPromiseHandler<T> push){return CompletableFuture.failedFuture(new UnsupportedOperationException("OAuth HTTP/2 push is unsupported"));}

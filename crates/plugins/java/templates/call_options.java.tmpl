package __PACKAGE__;
import java.time.Duration;
import java.util.Map;
/** Immutable options for a scoped call client; the original client remains unchanged. */
public record ClientCallOptions(Map<String,String> headers,Duration timeout) {
 public ClientCallOptions {headers=headers==null?Map.of():Map.copyOf(headers);if(timeout!=null&&(timeout.isNegative()||timeout.isZero()))throw new IllegalArgumentException("Call timeout must be positive");}
}

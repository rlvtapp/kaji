  public record Field<T>(boolean present, T value) {
    public static <T> Field<T> absent() {
      return new Field<>(false, null);
    }

    public static <T> Field<T> of(T value) {
      return new Field<>(true, value);
    }
  }

  public record GraphqlError(
      String message, JsonNode path, JsonNode locations, JsonNode extensions) {}

  public record Envelope<T>(
      boolean dataPresent,
      T data,
      java.util.List<GraphqlError> errors,
      JsonNode extensions,
      int status) {
    public boolean hasErrors() {
      return !errors.isEmpty();
    }

    public T requireData() {
      if (hasErrors() || !dataPresent || data == null) throw new GraphqlException(this);
      return data;
    }
  }

  public static final class GraphqlException extends RuntimeException {
    public final Envelope<?> response;

    public GraphqlException(Envelope<?> response) {
      super("GraphQL response has errors or no data");
      this.response = response;
    }
  }

  @FunctionalInterface
  public interface Decoder<T> {
    T decode(JsonNode node);
  }

  public interface Transport {
    default <T> java.util.stream.Stream<IncrementalSnapshot<T>> incremental(
        String document,
        String operation,
        ObjectNode variables,
        Decoder<T> decoder,
        JsonNode variableShape,
        JsonNode resultShape,
        JsonNode inputs)
        throws java.io.IOException, InterruptedException {
      throw new java.io.IOException("Incremental transport not configured");
    }

    default Map<String, ScalarCodec> scalarCodecs() {
      return Map.of();
    }

    default <T> Envelope<T> executeWithScalars(
        String document,
        String operation,
        ObjectNode variables,
        Decoder<T> decoder,
        JsonNode variableShape,
        JsonNode resultShape,
        JsonNode inputs)
        throws java.io.IOException, InterruptedException {
      return execute(
          document,
          operation,
          (ObjectNode) scalarTransform(variables, variableShape, inputs, scalarCodecs(), true),
          node ->
              decoder.decode(scalarTransform(node, resultShape, inputs, scalarCodecs(), false)));
    }

    default <T> java.util.stream.Stream<Envelope<T>> subscribeWithScalars(
        String document,
        String operation,
        ObjectNode variables,
        Decoder<T> decoder,
        JsonNode variableShape,
        JsonNode resultShape,
        JsonNode inputs)
        throws java.io.IOException, InterruptedException {
      return subscribe(
          document,
          operation,
          (ObjectNode) scalarTransform(variables, variableShape, inputs, scalarCodecs(), true),
          node ->
              decoder.decode(scalarTransform(node, resultShape, inputs, scalarCodecs(), false)));
    }

    default <T> java.util.stream.Stream<Envelope<T>> subscribe(
        String document, String operation, ObjectNode variables, Decoder<T> decoder)
        throws java.io.IOException, InterruptedException {
      throw new java.io.IOException("Subscription transport not configured");
    }

    <T> Envelope<T> execute(
        String document, String operation, ObjectNode variables, Decoder<T> decoder)
        throws java.io.IOException, InterruptedException;
  }

  public static final class HttpTransport implements Transport {
    private final java.net.URI endpoint;
    private final java.net.http.HttpClient http;
    private final Map<String, String> headers;
    private final Map<String, ScalarCodec> codecs;

    public HttpTransport(String endpoint) {
      this(endpoint, java.net.http.HttpClient.newHttpClient(), Map.of());
    }

    public HttpTransport(
        String endpoint, java.net.http.HttpClient http, Map<String, String> headers) {
      this(endpoint, http, headers, Map.of());
    }

    public HttpTransport(
        String endpoint,
        java.net.http.HttpClient http,
        Map<String, String> headers,
        Map<String, ScalarCodec> codecs) {
      this.endpoint = java.net.URI.create(endpoint);
      this.http = Objects.requireNonNull(http);
      this.headers = Map.copyOf(headers);
      this.codecs = Map.copyOf(codecs);
    }

    public Map<String, ScalarCodec> scalarCodecs() {
      return codecs;
    }

    public <T> Envelope<T> execute(
        String document, String operation, ObjectNode variables, Decoder<T> decoder)
        throws java.io.IOException, InterruptedException {
      ObjectNode request = JSON.createObjectNode();
      request.put("query", document);
      request.put("operationName", operation);
      request.set("variables", variables);
      var builder =
          java.net.http.HttpRequest.newBuilder(endpoint)
              .header("Content-Type", "application/json")
              .header("Accept", "application/graphql-response+json, application/json");
      headers.forEach(builder::header);
      var response =
          http.send(
              builder
                  .POST(
                      java.net.http.HttpRequest.BodyPublishers.ofString(
                          JSON.writeValueAsString(request)))
                  .build(),
              java.net.http.HttpResponse.BodyHandlers.ofString());
      JsonNode body = JSON.readTree(response.body());
      if (body == null || !body.isObject())
        throw new java.io.IOException("Malformed GraphQL response");
      java.util.List<GraphqlError> errors = new ArrayList<>();
      JsonNode err = body.get("errors");
      if (err != null) {
        if (!err.isArray() || err.isEmpty())
          throw new java.io.IOException("Malformed GraphQL errors");
        for (JsonNode e : err) {
          if (!e.isObject() || !e.path("message").isTextual())
            throw new java.io.IOException("Malformed GraphQL error");
          errors.add(
              new GraphqlError(
                  e.get("message").asText(),
                  e.get("path"),
                  e.get("locations"),
                  e.get("extensions")));
        }
      }
      if (!body.has("data") && errors.isEmpty())
        throw new java.io.IOException("GraphQL response contains neither data nor errors");
      if ((response.statusCode() < 200 || response.statusCode() >= 300) && errors.isEmpty())
        throw new java.io.IOException("HTTP status " + response.statusCode());
      T data;
      try {
        data = body.hasNonNull("data") ? decoder.decode(body.get("data")) : null;
      } catch (IllegalArgumentException malformed) {
        throw new java.io.IOException("Malformed GraphQL selected result", malformed);
      }
      return new Envelope<>(
          body.has("data"),
          data,
          java.util.List.copyOf(errors),
          body.get("extensions"),
          response.statusCode());
    }

    public <T> java.util.stream.Stream<IncrementalSnapshot<T>> incremental(
        String document,
        String operation,
        ObjectNode variables,
        Decoder<T> decoder,
        JsonNode variableShape,
        JsonNode resultShape,
        JsonNode inputs)
        throws java.io.IOException, InterruptedException {
      ObjectNode request = JSON.createObjectNode();
      request.put("query", document);
      request.put("operationName", operation);
      request.set("variables", scalarTransform(variables, variableShape, inputs, codecs, true));
      var builder =
          java.net.http.HttpRequest.newBuilder(endpoint)
              .header("Content-Type", "application/json")
              .header("Accept", "multipart/mixed;deferSpec=20220824, application/json");
      headers.forEach(builder::header);
      var response =
          http.send(
              builder
                  .POST(
                      java.net.http.HttpRequest.BodyPublishers.ofString(
                          JSON.writeValueAsString(request)))
                  .build(),
              java.net.http.HttpResponse.BodyHandlers.ofInputStream());
      String type = response.headers().firstValue("Content-Type").orElse("");
      if (response.statusCode() < 200 || response.statusCode() >= 300) {
        response.body().close();
        throw new java.io.IOException("GraphQL HTTP status " + response.statusCode());
      }
      if (type.toLowerCase(java.util.Locale.ROOT).startsWith("application/json")
          || type.toLowerCase(java.util.Locale.ROOT)
              .startsWith("application/graphql-response+json")) {
        try (var body = response.body()) {
          JsonNode result = JSON.readTree(body);
          if (result == null
              || !result.isObject()
              || result.has("hasNext")
              || result.has("incremental"))
            throw new java.io.IOException("Invalid incremental JSON fallback");
          envelope(result, response.statusCode(), node -> node);
          return java.util.stream.Stream.of(
              new IncrementalSnapshot<T>(
                  scalarTransform(result.get("data"), resultShape, inputs, codecs, false),
                  java.util.List.copyOf(patchErrors(result.get("errors"))),
                  result.get("extensions"),
                  java.util.List.of(),
                  true,
                  decoder));
        }
      }
      var version =
          java.util.regex.Pattern.compile("(?i);\\s*deferSpec\\s*=\\s*\"?([^;\"\\s]+)")
              .matcher(type);
      if (!type.toLowerCase(java.util.Locale.ROOT).startsWith("multipart/mixed")
          || version.find() && !version.group(1).equals("20220824")
          || type.toLowerCase(java.util.Locale.ROOT).contains("incrementalspec=")) {
        response.body().close();
        throw new java.io.IOException("Unsupported incremental response dialect");
      }
      var match =
          java.util.regex.Pattern.compile(
                  "(?i);\\s*boundary\\s*=\\s*(?:\"([^\"\\r\\n]+)\"|([^;\\s]+))")
              .matcher(type);
      if (!match.find()) {
        response.body().close();
        throw new java.io.IOException("Missing multipart boundary");
      }
      String token = match.group(1) != null ? match.group(1) : match.group(2);
      if (token.length() > 70) {
        response.body().close();
        throw new java.io.IOException("Invalid multipart boundary");
      }
      String boundary = "--" + token;
      var reader =
          new java.io.BufferedReader(
              new java.io.InputStreamReader(
                  response.body(), java.nio.charset.StandardCharsets.UTF_8));
      var iterator =
          new java.util.Spliterators.AbstractSpliterator<IncrementalSnapshot<T>>(
              Long.MAX_VALUE, java.util.Spliterator.ORDERED) {
            boolean started = false, closed = false, complete = false;
            JsonNode data = null, extensions = null;
            java.util.List<GraphqlError> errors = new ArrayList<>();

            public boolean tryAdvance(
                java.util.function.Consumer<? super IncrementalSnapshot<T>> consumer) {
              if (complete) return false;
              try {
                String line;
                if (!started) {
                  line = reader.readLine();
                  if (!boundary.equals(line))
                    throw new java.io.IOException("Invalid initial multipart boundary");
                }
                boolean json = false;
                while ((line = reader.readLine()) != null && !line.isEmpty()) {
                  if (line.toLowerCase(java.util.Locale.ROOT)
                      .matches("content-type: *application/json *")) json = true;
                }
                if (line == null || !json)
                  throw new java.io.IOException("Invalid multipart headers");
                StringBuilder content = new StringBuilder();
                while ((line = reader.readLine()) != null
                    && !line.equals(boundary)
                    && !line.equals(boundary + "--")) {
                  content.append(line).append('\n');
                  if (content.length() > 8 * 1024 * 1024)
                    throw new java.io.IOException("Incremental part exceeds limit");
                }
                if (line == null) throw new java.io.IOException("Truncated incremental stream");
                closed = line.equals(boundary + "--");
                JsonNode payload = JSON.readTree(content.toString());
                if (payload == null
                    || !payload.isObject()
                    || payload.has("pending")
                    || payload.has("completed")
                    || !payload.path("hasNext").isBoolean())
                  throw new java.io.IOException("Unsupported incremental payload dialect");
                var patches = new ArrayList<JsonNode>();
                if (!started) {
                  if (payload.has("incremental") || !payload.has("data") && !payload.has("errors"))
                    throw new java.io.IOException("Invalid initial incremental envelope");
                  data = payload.get("data");
                  if (data != null && !data.isNull() && !data.isObject())
                    throw new java.io.IOException("Invalid initial data");
                  data = data == null ? null : data.deepCopy();
                  started = true;
                } else if (payload.has("data"))
                  throw new java.io.IOException("Repeated initial data");
                errors.addAll(patchErrors(payload.get("errors")));
                if (payload.has("extensions")) extensions = payload.get("extensions").deepCopy();
                if (payload.has("incremental")) {
                  JsonNode incremental = payload.get("incremental");
                  if (!incremental.isArray() || incremental.isEmpty())
                    throw new java.io.IOException("Invalid incremental patches");
                  for (JsonNode patch : incremental) {
                    data = patchData(data, patch);
                    errors.addAll(patchErrors(patch.get("errors")));
                    patches.add(patch.deepCopy());
                  }
                }
                complete = !payload.get("hasNext").booleanValue();
                if (closed != complete)
                  throw new java.io.IOException("Incremental completion/boundary mismatch");
                if (complete) reader.close();
                consumer.accept(
                    new IncrementalSnapshot<T>(
                        scalarTransform(
                            data == null ? null : data.deepCopy(),
                            resultShape,
                            inputs,
                            codecs,
                            false),
                        java.util.List.copyOf(errors),
                        extensions == null ? null : extensions.deepCopy(),
                        java.util.List.copyOf(patches),
                        complete,
                        decoder));
                return true;
              } catch (java.io.IOException | IllegalArgumentException error) {
                complete = true;
                try {
                  reader.close();
                } catch (java.io.IOException ignored) {
                }
                throw new java.io.UncheckedIOException(
                    error instanceof java.io.IOException io
                        ? io
                        : new java.io.IOException("Malformed incremental result", error));
              }
            }
          };
      return java.util.stream.StreamSupport.stream(iterator, false)
          .onClose(
              () -> {
                try {
                  reader.close();
                } catch (java.io.IOException error) {
                  throw new java.io.UncheckedIOException(error);
                }
              });
    }

    public <T> java.util.stream.Stream<Envelope<T>> subscribe(
        String document, String operation, ObjectNode variables, Decoder<T> decoder)
        throws java.io.IOException, InterruptedException {
      ObjectNode request = JSON.createObjectNode();
      request.put("query", document);
      request.put("operationName", operation);
      request.set("variables", variables);
      var builder =
          java.net.http.HttpRequest.newBuilder(endpoint)
              .header("Content-Type", "application/json")
              .header("Accept", "text/event-stream");
      headers.forEach(builder::header);
      var response =
          http.send(
              builder
                  .POST(
                      java.net.http.HttpRequest.BodyPublishers.ofString(
                          JSON.writeValueAsString(request)))
                  .build(),
              java.net.http.HttpResponse.BodyHandlers.ofInputStream());
      if (response.statusCode() != 200
          || !response
              .headers()
              .firstValue("Content-Type")
              .orElse("")
              .toLowerCase(java.util.Locale.ROOT)
              .startsWith("text/event-stream")) {
        response.body().close();
        throw new java.io.IOException("Invalid GraphQL SSE response");
      }
      var reader =
          new java.io.BufferedReader(
              new java.io.InputStreamReader(
                  response.body(), java.nio.charset.StandardCharsets.UTF_8));
      var iterator =
          new java.util.Spliterators.AbstractSpliterator<Envelope<T>>(
              Long.MAX_VALUE, java.util.Spliterator.ORDERED) {
            boolean done = false;

            public boolean tryAdvance(java.util.function.Consumer<? super Envelope<T>> consumer) {
              if (done) return false;
              try {
                String event = "";
                StringBuilder data = new StringBuilder();
                int bytes = 0;
                String line;
                while ((line = reader.readLine()) != null) {
                  bytes += line.length();
                  if (bytes > 8 * 1024 * 1024)
                    throw new java.io.IOException("SSE event exceeds limit");
                  if (line.isEmpty()) {
                    if (event.equals("complete")) {
                      done = true;
                      reader.close();
                      return false;
                    }
                    if (event.isEmpty() && data.length() == 0) continue;
                    if (!event.equals("next"))
                      throw new java.io.IOException("Unsupported GraphQL SSE event " + event);
                    JsonNode body = JSON.readTree(data.toString());
                    consumer.accept(envelope(body, response.statusCode(), decoder));
                    return true;
                  }
                  if (line.startsWith(":")) continue;
                  int colon = line.indexOf(':');
                  String key = colon < 0 ? line : line.substring(0, colon);
                  String value = colon < 0 ? "" : line.substring(colon + 1);
                  if (value.startsWith(" ")) value = value.substring(1);
                  if (key.equals("event")) event = value;
                  else if (key.equals("data")) {
                    if (data.length() > 0) data.append('\n');
                    data.append(value);
                  }
                }
                throw new java.io.IOException("GraphQL SSE ended before complete");
              } catch (java.io.IOException | IllegalArgumentException error) {
                done = true;
                try {
                  reader.close();
                } catch (java.io.IOException ignored) {
                }
                throw new java.io.UncheckedIOException(
                    error instanceof java.io.IOException io
                        ? io
                        : new java.io.IOException("Malformed SSE GraphQL result", error));
              }
            }
          };
      return java.util.stream.StreamSupport.stream(iterator, false)
          .onClose(
              () -> {
                try {
                  reader.close();
                } catch (java.io.IOException error) {
                  throw new java.io.UncheckedIOException(error);
                }
              });
    }
  }

  private static final ObjectMapper JSON = new ObjectMapper();

  public interface Input {
    ObjectNode toJson();
  }

  private static JsonNode encode(Object value) {
    if (value == null) return NullNode.instance;
    if (value instanceof Input input) return input.toJson();
    if (value instanceof java.util.List<?> list) {
      ArrayNode node = JSON.createArrayNode();
      for (Object item : list) node.add(encode(item));
      return node;
    }
    return JSON.valueToTree(value);
  }

  private static <T> java.util.List<T> list(JsonNode node, Decoder<T> decoder) {
    if (node == null || !node.isArray())
      throw new IllegalArgumentException("Expected GraphQL list");
    java.util.List<T> result = new ArrayList<>();
    for (JsonNode item : node) result.add(decoder.decode(item));
    return Collections.unmodifiableList(result);
  }

  private static JsonNode field(JsonNode object, String name) {
    if (object == null || !object.isObject() || !object.has(name))
      throw new IllegalArgumentException("Missing GraphQL field " + name);
    return object.get(name);
  }

  private static String text(JsonNode node) {
    if (!node.isTextual()) throw new IllegalArgumentException("Expected GraphQL string");
    return node.asText();
  }

  private static Integer integer(JsonNode node) {
    if (!node.isIntegralNumber() || !node.canConvertToInt())
      throw new IllegalArgumentException("Expected GraphQL Int");
    return node.intValue();
  }

  private static Double number(JsonNode node) {
    if (!node.isNumber()) throw new IllegalArgumentException("Expected GraphQL Float");
    return node.doubleValue();
  }

  private static Boolean bool(JsonNode node) {
    if (!node.isBoolean()) throw new IllegalArgumentException("Expected GraphQL Boolean");
    return node.booleanValue();
  }

  private static String literal(JsonNode node, String expected) {
    String value = text(node);
    if (!value.equals(expected)) throw new IllegalArgumentException("Invalid GraphQL literal");
    return value;
  }

  private static String enumValue(JsonNode node, java.util.List<String> values) {
    String value = text(node);
    if (!values.contains(value)) throw new IllegalArgumentException("Invalid GraphQL enum");
    return value;
  }

  private static JsonNode scalarNode(JsonNode node) {
    if (node.isNull()) throw new IllegalArgumentException("Non-null GraphQL scalar");
    return node;
  }

  private static <T> Envelope<T> envelope(JsonNode body, int status, Decoder<T> decoder)
      throws java.io.IOException {
    if (body == null || !body.isObject() || body.has("hasNext") || body.has("incremental"))
      throw new java.io.IOException("Invalid GraphQL SSE envelope");
    java.util.List<GraphqlError> errors = new ArrayList<>();
    JsonNode err = body.get("errors");
    if (err != null) {
      if (!err.isArray() || err.isEmpty())
        throw new java.io.IOException("Malformed GraphQL errors");
      for (JsonNode e : err) {
        if (!e.isObject() || !e.path("message").isTextual())
          throw new java.io.IOException("Malformed GraphQL error");
        errors.add(
            new GraphqlError(
                e.get("message").asText(), e.get("path"), e.get("locations"), e.get("extensions")));
      }
    }
    if (!body.has("data") && errors.isEmpty())
      throw new java.io.IOException("GraphQL response contains neither data nor errors");
    return new Envelope<>(
        body.has("data"),
        body.hasNonNull("data") ? decoder.decode(body.get("data")) : null,
        java.util.List.copyOf(errors),
        body.get("extensions"),
        status);
  }

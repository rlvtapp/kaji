public record IncrementalSnapshot<T>(JsonNode data, java.util.List<GraphqlError> errors, JsonNode extensions, java.util.List<JsonNode> patches, boolean complete, Decoder<T> decoder) {
 public T decodeData(){if(!complete||!errors.isEmpty()||data==null||data.isNull())throw new IllegalStateException("Incremental data is incomplete or has GraphQL errors");return decoder.decode(data);}
}
private static JsonNode patchAt(JsonNode root,JsonNode path,int length) throws java.io.IOException {
 JsonNode value=root;for(int i=0;i<length;i++){JsonNode key=path.get(i);if(key.isTextual()){if(java.util.List.of("__proto__","constructor","prototype").contains(key.asText())||value==null||!value.isObject()||!value.has(key.asText()))throw new java.io.IOException("Invalid incremental object path");value=value.get(key.asText());}else if(key.isIntegralNumber()&&key.canConvertToInt()&&key.intValue()>=0&&value!=null&&value.isArray()&&key.intValue()<value.size())value=value.get(key.intValue());else throw new java.io.IOException("Invalid incremental path");}return value;
}
private static JsonNode patchData(JsonNode root,JsonNode patch) throws java.io.IOException {
 JsonNode path=patch.get("path");if(path==null||!path.isArray()||patch.has("id")||patch.has("subPath"))throw new java.io.IOException("Unsupported incremental patch dialect");
 if(patch.has("data")==patch.has("items"))throw new java.io.IOException("Patch needs data or items");
 if(patch.has("items")){if(path.isEmpty()||!patch.get("items").isArray())throw new java.io.IOException("Invalid stream patch");JsonNode index=path.get(path.size()-1);JsonNode list=patchAt(root,path,path.size()-1);if(!index.isIntegralNumber()||!index.canConvertToInt()||!list.isArray()||index.intValue()!=list.size())throw new java.io.IOException("Stream patch must append contiguous items");for(JsonNode item:patch.get("items"))((ArrayNode)list).add(item.deepCopy());return root;}
 JsonNode data=patch.get("data");JsonNode target=patchAt(root,path,path.size());if(data.isNull()){if(path.isEmpty())return NullNode.instance;JsonNode parent=patchAt(root,path,path.size()-1),key=path.get(path.size()-1);if(parent.isArray())((ArrayNode)parent).set(key.intValue(),NullNode.instance);else ((ObjectNode)parent).set(key.asText(),NullNode.instance);return root;}
 if(!data.isObject()||!target.isObject())throw new java.io.IOException("Invalid deferred object");var fields=data.fields();while(fields.hasNext()){var field=fields.next();if(java.util.List.of("__proto__","constructor","prototype").contains(field.getKey()))throw new java.io.IOException("Unsafe incremental property");((ObjectNode)target).set(field.getKey(),field.getValue().deepCopy());}return root;
}
private static java.util.List<GraphqlError> patchErrors(JsonNode errors) throws java.io.IOException {var out=new ArrayList<GraphqlError>();if(errors==null)return out;if(!errors.isArray()||errors.isEmpty())throw new java.io.IOException("Invalid incremental errors");for(JsonNode e:errors){if(!e.isObject()||!e.path("message").isTextual())throw new java.io.IOException("Invalid incremental error");out.add(new GraphqlError(e.get("message").asText(),e.get("path"),e.get("locations"),e.get("extensions")));}return out;}

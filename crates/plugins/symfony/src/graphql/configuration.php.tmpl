<?php

declare(strict_types=1);

namespace __NAMESPACE__\DependencyInjection;

use Symfony\Component\Config\Definition\Builder\TreeBuilder;
use Symfony\Component\Config\Definition\ConfigurationInterface;

final class Configuration implements ConfigurationInterface
{
    public function getConfigTreeBuilder(): TreeBuilder
    {
        $tree = new TreeBuilder('__ALIAS__');
        $tree->getRootNode()->children()
            ->scalarNode('endpoint')->isRequired()->cannotBeEmpty()->end()
            ->arrayNode('headers')->useAttributeAsKey('name')->scalarPrototype()->end()->defaultValue([])->end()
            ->floatNode('timeout')->min(0.001)->defaultValue(30.0)->end()
            ->scalarNode('http_client')->cannotBeEmpty()->defaultValue('http_client')->end()
        ->end();
        return $tree;
    }
}

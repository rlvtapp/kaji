/** Runtime-only per-call controls; API-declared headers remain separately typed. */
export interface RequestOptions { headers?: HeadersInit; timeoutMs?: number; signal?: AbortSignal }
export class PoolsterRequestTimeoutError extends Error { constructor() { super('Request timed out'); this.name = 'TimeoutError' } }
export async function withRequestControl<T>(options: RequestOptions | undefined, defaultTimeoutMs: number | undefined, run: (options: RequestOptions) => Promise<T>): Promise<T> {
  const prepared = { ...options, headers: options?.headers ? new Headers(options.headers) : undefined }
  const timeoutMs = options?.timeoutMs ?? defaultTimeoutMs
  if (timeoutMs !== undefined && (!Number.isFinite(timeoutMs) || timeoutMs <= 0 || timeoutMs > 2_147_483_647)) throw new RangeError('timeoutMs must be a finite positive timer duration')
  const caller = options?.signal
  if (caller?.aborted) throw caller.reason ?? new DOMException('Request cancelled', 'AbortError')
  if (timeoutMs === undefined && !caller) return run(prepared)
  const controller = timeoutMs === undefined ? undefined : new AbortController()
  const forward = () => controller?.abort(caller?.reason)
  if (controller && caller) caller.addEventListener('abort', forward, { once: true })
  const combine = (AbortSignal as typeof AbortSignal & { any?: (signals: AbortSignal[]) => AbortSignal }).any
  const signal = controller && caller && combine ? combine.call(AbortSignal, [controller.signal, caller]) : controller?.signal ?? caller!
  const timer = timeoutMs === undefined ? undefined : setTimeout(() => controller!.abort(new PoolsterRequestTimeoutError()), timeoutMs)
  let rejectAbort!: () => void
  const cancelled = new Promise<never>((_, reject) => {
    rejectAbort = () => reject(signal.reason ?? new DOMException('Request cancelled', 'AbortError'))
    signal.addEventListener('abort', rejectAbort, { once: true })
  })
  try {
    return await Promise.race([Promise.resolve().then(() => {
      signal.throwIfAborted()
      return run({ ...prepared, signal })
    }), cancelled])
  } finally {
    if (timer !== undefined) clearTimeout(timer)
    signal.removeEventListener('abort', rejectAbort)
    if (controller && caller) caller.removeEventListener('abort', forward)
  }
}
const requestRetryPause = (delay: number, signal?: AbortSignal): Promise<void> => {
  signal?.throwIfAborted()
  return new Promise((resolve, reject) => {
    const abort = () => { clearTimeout(timer); signal?.removeEventListener('abort', abort); reject(signal?.reason ?? new DOMException('Request cancelled', 'AbortError')) }
    const timer = setTimeout(() => { signal?.removeEventListener('abort', abort); resolve() }, delay)
    signal?.addEventListener('abort', abort, { once: true })
    if (signal?.aborted) abort()
  })
}

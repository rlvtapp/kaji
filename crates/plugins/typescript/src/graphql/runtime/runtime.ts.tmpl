/** Generated by Poolster. Application errors preserve partial data. */
export interface GraphqlError {
  message: string;
  locations?: ReadonlyArray<{ line: number; column: number }>;
  path?: ReadonlyArray<string | number>;
  extensions?: Record<string, unknown>;
}
export type GraphqlResult<T> =
  | { kind: "success"; data: T; errors?: never; extensions?: Record<string, unknown> }
  | {
      kind: "partial";
      data: T;
      errors: readonly GraphqlError[];
      extensions?: Record<string, unknown>;
    }
  | {
      kind: "error";
      data?: null;
      errors: readonly GraphqlError[];
      extensions?: Record<string, unknown>;
    };
import type { ScalarCodecMap } from "./graphql-scalar-runtime.js";
export interface RequestOptions {
  signal?: AbortSignal;
  headers?: HeadersInit;
  scalarCodecs?: ScalarCodecMap;
}
export interface GraphqlTransport {
  readonly scalarCodecs?: ScalarCodecMap;
  execute<T>(
    document: string,
    operationName: string,
    variables: object,
    options?: RequestOptions,
  ): Promise<GraphqlResult<T>>;
}
/** HTTP cannot subscribe. Inject an independent WebSocket/SSE transport. */
export interface SubscriptionTransport {
  readonly scalarCodecs?: ScalarCodecMap;
  subscribe<T>(
    document: string,
    operationName: string,
    variables: object,
    options?: RequestOptions,
  ): AsyncIterable<GraphqlResult<T>>;
}
export class GraphqlHttpError extends Error {
  constructor(
    public readonly status: number,
    public readonly body: string,
  ) {
    super(`GraphQL HTTP request failed (${status})`);
    this.name = "GraphqlHttpError";
  }
}
export class GraphqlProtocolError extends Error {
  constructor(message: string) {
    super(message);
    this.name = "GraphqlProtocolError";
  }
}
export function createGraphqlHttpTransport(
  endpoint: string,
  config: {
    fetch?: typeof globalThis.fetch;
    headers?: HeadersInit;
    scalarCodecs?: ScalarCodecMap;
  } = {},
): GraphqlTransport {
  const fetcher = config.fetch ?? globalThis.fetch;
  return {
    scalarCodecs: config.scalarCodecs,
    async execute<T>(
      document: string,
      operationName: string,
      variables: object,
      options?: RequestOptions,
    ): Promise<GraphqlResult<T>> {
      const headers = new Headers(config.headers);
      new Headers(options?.headers).forEach((value, name) => headers.set(name, value));
      headers.set("content-type", "application/json");
      headers.set("accept", "application/graphql-response+json, application/json");
      const response = await fetcher(endpoint, {
        method: "POST",
        headers,
        signal: options?.signal,
        body: JSON.stringify({ query: document, operationName, variables }),
      });
      const body = await response.text();
      if (!response.ok) throw new GraphqlHttpError(response.status, body);
      let payload: unknown;
      try {
        payload = JSON.parse(body);
      } catch {
        throw new GraphqlProtocolError("GraphQL response is not JSON");
      }
      return parseGraphqlResult<T>(payload);
    },
  };
}

/** Shared strict envelope decoding for HTTP and separately configured streaming transports. */
export function parseGraphqlResult<T>(payload: unknown): GraphqlResult<T> {
  if (payload === null || typeof payload !== "object" || Array.isArray(payload))
    throw new GraphqlProtocolError("GraphQL response must be an object");
  const result = payload as {
    data?: T | null;
    errors?: GraphqlError[];
    extensions?: Record<string, unknown>;
  };
  if (
    result.data !== undefined &&
    result.data !== null &&
    (typeof result.data !== "object" || Array.isArray(result.data))
  )
    throw new GraphqlProtocolError("GraphQL data must be an object or null");
  if (
    result.extensions !== undefined &&
    (result.extensions === null ||
      typeof result.extensions !== "object" ||
      Array.isArray(result.extensions))
  )
    throw new GraphqlProtocolError("GraphQL extensions must be an object");
  if (
    result.errors !== undefined &&
    (!Array.isArray(result.errors) ||
      result.errors.length === 0 ||
      result.errors.some((error) => !error || typeof error.message !== "string"))
  )
    throw new GraphqlProtocolError("Invalid GraphQL errors");
  if (result.errors)
    return result.data == null
      ? {
          kind: "error",
          data: result.data === null ? null : undefined,
          errors: result.errors,
          extensions: result.extensions,
        }
      : {
          kind: "partial",
          data: result.data,
          errors: result.errors,
          extensions: result.extensions,
        };
  if (result.data == null)
    throw new GraphqlProtocolError("GraphQL response has neither data nor errors");
  return { kind: "success", data: result.data, extensions: result.extensions };
}

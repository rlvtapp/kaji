{
  "name": "@relevate/unplugin-poolster",
  "version": "0.1.0",
  "description": "Run Poolster OpenAPI generation from Vite, Rollup, webpack, esbuild, Rspack, Rolldown, Farm, Nuxt, and Astro builds.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rlvtapp/kaji.git"
  },
  "main": "src/index.cjs",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.cjs",
      "default": "./src/index.cjs"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "require": "./src/vite.cjs",
      "default": "./src/vite.cjs"
    },
    "./rollup": {
      "types": "./src/rollup.d.ts",
      "require": "./src/rollup.cjs",
      "default": "./src/rollup.cjs"
    },
    "./webpack": {
      "types": "./src/webpack.d.ts",
      "require": "./src/webpack.cjs",
      "default": "./src/webpack.cjs"
    },
    "./esbuild": {
      "types": "./src/esbuild.d.ts",
      "require": "./src/esbuild.cjs",
      "default": "./src/esbuild.cjs"
    },
    "./rspack": {
      "types": "./src/rspack.d.ts",
      "require": "./src/rspack.cjs",
      "default": "./src/rspack.cjs"
    },
    "./rolldown": {
      "types": "./src/rolldown.d.ts",
      "require": "./src/rolldown.cjs",
      "default": "./src/rolldown.cjs"
    },
    "./farm": {
      "types": "./src/farm.d.ts",
      "require": "./src/farm.cjs",
      "default": "./src/farm.cjs"
    },
    "./nuxt": {
      "types": "./src/nuxt.d.ts",
      "require": "./src/nuxt.cjs",
      "default": "./src/nuxt.cjs"
    },
    "./astro": {
      "types": "./src/astro.d.ts",
      "require": "./src/astro.cjs",
      "default": "./src/astro.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.cjs"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.0.0 || ^4.0.0",
    "unplugin": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "unplugin": {
      "optional": true
    }
  },
  "keywords": [
    "openapi",
    "codegen",
    "poolster",
    "unplugin",
    "vite",
    "rollup",
    "webpack",
    "esbuild",
    "rspack",
    "rolldown",
    "farm",
    "nuxt",
    "astro"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@relevate/poolster",
  "version": "0.5.0-alpha.1",
  "description": "Poolster Node SDK for embedded and plugin-based generation",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/rlvtapp/poolster.git" },
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.mjs", "require": "./index.cjs" },
    "./plugins": { "types": "./plugins.d.ts", "import": "./plugins.mjs", "require": "./plugins.cjs" },
    "./package.json": "./package.json"
  },
  "files": ["index.cjs", "index.mjs", "index.d.ts", "plugins.cjs", "plugins.mjs", "plugins.d.ts", "plugin-engine.cjs", "plan.cjs", "config.cjs", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "build:native": "node scripts/build-native.mjs"
  },
  "optionalDependencies": {
    "@relevate/poolster-node-darwin-arm64": "0.5.0-alpha.1",
    "@relevate/poolster-node-darwin-x64": "0.5.0-alpha.1",
    "@relevate/poolster-node-linux-x64-gnu": "0.5.0-alpha.1",
    "@relevate/poolster-node-win32-x64-msvc": "0.5.0-alpha.1"
  },
  "publishConfig": { "access": "public" }
}

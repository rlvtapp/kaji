{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rlvtapp/kaji/main/schemas/v1/kaji.schema.json",
  "title": "Kaji configuration",
  "description": "Configuration for Kaji's multi-language OpenAPI SDK generator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "openapi",
    "output",
    "packages"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema location used by editors for completion and validation."
    },
    "openapi": {
      "$ref": "#/$defs/openapi"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Generated release root, relative to this config file."
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_style": {
          "$ref": "#/$defs/clientStyle"
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "clientStyle": {
      "type": "string",
      "enum": [
        "namespaced",
        "flat"
      ],
      "default": "namespaced",
      "description": "Namespaced resource client or direct operation methods."
    },
    "secret": {
      "description": "Literal value, environment-variable reference, or named Kaji auth profile. Prefer an environment or profile reference for credentials.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "env"
          ],
          "properties": {
            "env": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile"
          ],
          "properties": {
            "profile": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "remoteInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Remote OpenAPI URL."
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/secret"
          },
          "description": "Headers sent while downloading the OpenAPI document."
        },
        "auth": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "username",
                "password"
              ],
              "properties": {
                "type": {
                  "const": "basic"
                },
                "username": {
                  "$ref": "#/$defs/secret"
                },
                "password": {
                  "$ref": "#/$defs/secret"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "token"
              ],
              "properties": {
                "type": {
                  "const": "bearer"
                },
                "token": {
                  "$ref": "#/$defs/secret"
                }
              }
            }
          ]
        }
      }
    },
    "openapi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": {
          "description": "Local OpenAPI YAML/JSON file or a remote OpenAPI request.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "$ref": "#/$defs/remoteInput"
            }
          ]
        },
        "artifacts": {
          "type": "string",
          "minLength": 1,
          "description": "Existing Kaji compiler artifact directory."
        },
        "name": {
          "type": "string",
          "default": "API"
        },
        "version": {
          "type": "string",
          "default": "0.1.0"
        },
        "compiler": {
          "type": "string",
          "description": "Optional replacement kaji-openapi executable."
        },
        "paths": {
          "$ref": "#/$defs/pathSelection"
        }
      },
      "oneOf": [
        {
          "required": [
            "input"
          ],
          "not": {
            "required": [
              "artifacts"
            ]
          }
        },
        {
          "required": [
            "artifacts"
          ],
          "not": {
            "required": [
              "input"
            ]
          }
        }
      ]
    },
    "pathSelection": {
      "type": "object",
      "additionalProperties": false,
      "description": "Select a focused API surface before every package is generated. Include patterns are ORed; excludes always win. Patterns use * for any sequence, including /, and ? for one character.",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/"
          },
          "description": "Only generate operations whose OpenAPI path matches one of these patterns. Empty means every path."
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/"
          },
          "description": "Never generate operations whose OpenAPI path matches one of these patterns."
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "path",
        "plugins"
      ],
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "typescript",
            "typescript-cli",
            "rust",
            "rust-cli",
            "go",
            "python",
            "php",
            "symfony",
            "java",
            "csharp",
            "dotnet",
            "elixir",
            "ruby",
            "swift",
            "mock",
            "artifacts",
            "postman",
            "terraform"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Safe path below output.path."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Generated package identity."
        },
        "client_style": {
          "$ref": "#/$defs/clientStyle"
        },
        "plugins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/plugin"
          }
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Independent SDK version. Release metadata may seed this from the last published package."
        },
        "release": {
          "$ref": "#/$defs/packageMetadata"
        },
        "customizations": {
          "type": "array",
          "description": "SDK-author source overlays applied after generation, scoped to this package. Sources are relative to the config file.",
          "items": {
            "$ref": "#/$defs/codeCustomization"
          }
        },
        "middleware": {
          "type": "array",
          "description": "Author-supplied runtime middleware bundled and enabled by default in this SDK package.",
          "items": {
            "$ref": "#/$defs/bundledMiddleware"
          }
        },
        "api_reference": {
          "type": "boolean",
          "default": false,
          "description": "Emit an operation-derived API_REFERENCE.md through the typed API reference plugin."
        },
        "idempotency": {
          "$ref": "#/$defs/idempotencyConfig",
          "description": "Opt-in package-local idempotency. Absent policies are disabled. Defaults override operation x-kaji-idempotency extensions; operation rules override defaults. Automatic key generation is disabled unless requested."
        }
      }
    },
    "plugin": {
      "anyOf": [
        {
          "$ref": "#/$defs/sdkPlugin"
        },
        {
          "$ref": "#/$defs/typescriptCliPlugin"
        },
        {
          "$ref": "#/$defs/rustCliPlugin"
        },
        {
          "$ref": "#/$defs/typescriptArtifactPlugin"
        },
        {
          "$ref": "#/$defs/redocPlugin"
        },
        {
          "$ref": "#/$defs/mcpPlugin"
        },
        {
          "$ref": "#/$defs/mockPlugin"
        },
        {
          "$ref": "#/$defs/typescriptProviderPlugin"
        },
        {
          "$ref": "#/$defs/pythonConsumerPlugin"
        },
        {
          "$ref": "#/$defs/postmanPlugin"
        },
        {
          "$ref": "#/$defs/terraformPlugin"
        },
        {
          "$ref": "#/$defs/nativeConsumerPlugin"
        },
        {
          "$ref": "#/$defs/operationTestsPlugin"
        }
      ]
    },
    "sdkPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "const": "sdk"
        },
        "transport": {
          "type": "string",
          "enum": [
            "fetch",
            "axios"
          ],
          "default": "fetch"
        },
        "surface": {
          "type": "string",
          "enum": [
            "client",
            "raw"
          ],
          "default": "client"
        },
        "client_name": {
          "type": "string",
          "minLength": 1
        },
        "group_by_tag": {
          "type": "boolean",
          "default": true
        },
        "throw_on_error": {
          "type": "boolean",
          "default": true
        },
        "jobs": {
          "type": "integer",
          "minimum": 1,
          "description": "Go generation worker count."
        },
        "sdk_package": {
          "type": "string",
          "minLength": 1,
          "description": "Composer package identity of the PHP SDK wrapped by a Symfony package."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique provider or consumer instance name."
        },
        "uses": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "models": {
              "type": "string",
              "minLength": 1
            },
            "transport": {
              "type": "string",
              "minLength": 1
            },
            "operations": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "Select a named provider; unbound roles require one unambiguous compatible provider."
        },
        "integer_as_string": {
          "type": "boolean"
        },
        "int64": {
          "type": "string",
          "enum": [
            "number",
            "string",
            "bigint"
          ],
          "default": "number"
        },
        "async_client": {
          "type": "boolean",
          "description": "Generate an optional httpx async Python client."
        },
        "open_enums": {
          "type": "boolean",
          "description": "Generate forward-compatible Java, C# or Swift named string enum value classes."
        },
        "preserve_presence": {
          "type": "boolean",
          "default": false,
          "description": "Opt-in Java/C# Presence wrappers for omitted versus explicit-null optional properties; changes the optional-property API."
        }
      }
    },
    "typescriptArtifactPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "zod",
            "tanstack-react-query",
            "tanstack-vue-query",
            "swr",
            "faker",
            "msw",
            "cypress"
          ]
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "clients_import": {
          "type": "string",
          "minLength": 1
        },
        "group_by_tag": {
          "type": "boolean",
          "default": true
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique provider or consumer instance name."
        },
        "uses": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "models": {
              "type": "string",
              "minLength": 1
            },
            "transport": {
              "type": "string",
              "minLength": 1
            },
            "operations": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "Select a named provider; unbound roles require one unambiguous compatible provider."
        }
      }
    },
    "typescriptCliPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "const": "cli"
        },
        "command_name": {
          "type": "string",
          "minLength": 1,
          "description": "Executable command name. Defaults to the API name."
        },
        "base_url": {
          "type": "string",
          "format": "uri",
          "description": "Default API origin. Users can override it with --base-url or the generated environment variable."
        },
        "oauth": {
          "$ref": "#/$defs/cliOAuth"
        }
      }
    },
    "rustCliPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "const": "cli"
        },
        "command_name": {
          "type": "string",
          "minLength": 1,
          "description": "Executable command name. Defaults to the API name."
        },
        "base_url": {
          "type": "string",
          "format": "uri",
          "description": "Default API origin. Users can override it with --base-url or the generated environment variable."
        }
      }
    },
    "cliOAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_id"
      ],
      "properties": {
        "client_id": {
          "type": "string",
          "minLength": 1,
          "description": "Public OAuth client identifier registered for this CLI."
        },
        "security_scheme": {
          "type": "string",
          "minLength": 1,
          "description": "OpenAPI OAuth security scheme used by access tokens."
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "preferred_flow": {
          "type": "string",
          "enum": [
            "device",
            "browser"
          ],
          "default": "device"
        },
        "authorization_url": {
          "type": "string",
          "format": "uri",
          "description": "Overrides the OpenAPI authorizationCode flow URL."
        },
        "device_authorization_url": {
          "type": "string",
          "format": "uri",
          "description": "RFC 8628 device authorization endpoint."
        },
        "token_url": {
          "type": "string",
          "format": "uri",
          "description": "Overrides the OpenAPI OAuth token URL."
        },
        "redirect_uri": {
          "type": "string",
          "format": "uri",
          "description": "Registered loopback callback for PKCE browser login."
        }
      }
    },
    "redocPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "const": "redoc"
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "openapi_spec": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mcpPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "const": "mcp"
        },
        "output": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mockPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "const": "server"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "typescriptProviderPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "enum": [
            "models",
            "transport",
            "operations",
            "client"
          ]
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "enum": [
            "fetch",
            "axios"
          ]
        },
        "client_name": {
          "type": "string",
          "minLength": 1
        },
        "throw_on_error": {
          "type": "boolean"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique provider or consumer instance name."
        },
        "uses": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "models": {
              "type": "string",
              "minLength": 1
            },
            "transport": {
              "type": "string",
              "minLength": 1
            },
            "operations": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "Select a named provider; unbound roles require one unambiguous compatible provider."
        },
        "integer_as_string": {
          "type": "boolean"
        },
        "int64": {
          "type": "string",
          "enum": [
            "number",
            "string",
            "bigint"
          ],
          "default": "number"
        }
      }
    },
    "pythonConsumerPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "enum": [
            "webhooks",
            "roundtrips",
            "operation-tests"
          ]
        }
      }
    },
    "packageCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program"
      ],
      "properties": {
        "program": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "packageMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1
        },
        "name": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "build": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packageCommand"
          }
        },
        "test": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packageCommand"
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "publisher": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registry",
            "release_type"
          ],
          "properties": {
            "registry": {
              "type": "string",
              "minLength": 1
            },
            "release_type": {
              "type": "string",
              "minLength": 1
            },
            "commands": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/packageCommand"
              }
            },
            "extra_files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": "Omit commands for standard npm/pypi/crates.io/go trusted publishing; custom registries require commands."
        }
      }
    },
    "codeCustomization": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "path",
            "source"
          ],
          "properties": {
            "mode": {
              "const": "add"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "File path relative to this package."
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "description": "UTF-8 source file relative to the Kaji config."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "path",
            "source"
          ],
          "properties": {
            "mode": {
              "const": "replace"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "File path relative to this package."
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "description": "UTF-8 source file relative to the Kaji config."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "path",
            "source",
            "find"
          ],
          "properties": {
            "mode": {
              "const": "patch"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "File path relative to this package."
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "description": "UTF-8 source file relative to the Kaji config."
            },
            "find": {
              "type": "string",
              "minLength": 1,
              "description": "Exact text that must occur once in the generated file."
            }
          }
        }
      ]
    },
    "bundledMiddleware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "path",
        "symbol"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "UTF-8 middleware source relative to the Kaji config."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Destination module/file relative to this SDK package; must match native compiled source layout."
        },
        "symbol": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Middleware function, factory, or class according to this language ABI."
        },
        "async_symbol": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Optional Python async middleware function, required when bundling middleware in async output."
        }
      }
    },
    "postmanPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "enum": [
            "collection",
            "environment"
          ]
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "strict": {
          "type": "boolean",
          "default": true
        },
        "group_by_tag": {
          "type": "boolean",
          "default": true
        },
        "base_url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "terraformResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "create",
        "read",
        "delete"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "create": {
          "type": "string",
          "minLength": 1
        },
        "read": {
          "type": "string",
          "minLength": 1
        },
        "update": {
          "type": "string",
          "minLength": 1
        },
        "delete": {
          "type": "string",
          "minLength": 1
        },
        "id_parameter": {
          "type": "string",
          "minLength": 1
        },
        "id_field": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16,
          "default": 0,
          "description": "Current Terraform resource schema version; explicitly cover every prior version in state_upgrades."
        },
        "state_upgrades": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "rename_fields"
            ],
            "properties": {
              "version": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "rename_fields": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "description": "Explicit old-state version to current-schema root attribute renames. No inferred type conversions."
        },
        "identity": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parameter",
              "field"
            ],
            "properties": {
              "parameter": {
                "type": "string",
                "minLength": 1
              },
              "field": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": "Explicit composite identity components: item path parameter mapped to a required string response field. Omit legacy id_parameter/id_field."
        },
        "polling": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "create": {
              "$ref": "#/$defs/terraformPolling"
            },
            "update": {
              "$ref": "#/$defs/terraformPolling"
            },
            "delete": {
              "$ref": "#/$defs/terraformPolling"
            }
          },
          "description": "Bounded cancellable lifecycle waiters using this resource read operation; mutation is never replayed."
        }
      }
    },
    "terraformPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "const": "provider"
        },
        "infer": {
          "type": "boolean",
          "default": true
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "provider_name": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/terraformResource"
          }
        },
        "data_sources": {
          "type": "boolean",
          "default": false,
          "description": "Generate typed single-entity Terraform data sources from validated resource read plans."
        },
        "registry_namespace": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$"
        }
      }
    },
    "idempotencyRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "header": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$",
          "default": "Idempotency-Key"
        },
        "auto_generate": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "idempotencyConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "$ref": "#/$defs/idempotencyRule"
        },
        "operations": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/idempotencyRule"
          }
        }
      }
    },
    "nativeConsumerPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "enum": [
            "webhooks",
            "oauth",
            "release-scaffold"
          ]
        }
      }
    },
    "operationTestsPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "const": "operation-tests"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "uses": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operations": {
              "type": "string",
              "minLength": 1
            },
            "transport": {
              "type": "string",
              "minLength": 1
            },
            "models": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "description": "Generate bounded fake-driver public-operation tests and unsupported-case diagnostics. All SDK recipes support inference; named uses roles are supported by TypeScript recipes only."
    },
    "terraformPollCriterion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pointer",
            "equals"
          ],
          "properties": {
            "pointer": {
              "type": "string",
              "pattern": "^(?:/(?:[^~]|~[01])*)*$"
            },
            "equals": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        }
      ]
    },
    "terraformPolling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success"
      ],
      "properties": {
        "delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000,
          "default": 0
        },
        "interval_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000,
          "default": 1000
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 60
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000,
          "default": 120000
        },
        "success": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/terraformPollCriterion"
          }
        },
        "failure": {
          "type": "array",
          "maxItems": 32,
          "default": [],
          "items": {
            "$ref": "#/$defs/terraformPollCriterion"
          }
        }
      }
    }
  }
}

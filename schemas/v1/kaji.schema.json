{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rlvtapp/kaji/main/schemas/v1/kaji.schema.json",
  "title": "Kaji configuration",
  "description": "Configuration for Kaji's multi-language OpenAPI SDK generator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["openapi", "output", "packages"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema location used by editors for completion and validation."
    },
    "openapi": { "$ref": "#/$defs/openapi" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "description": "Generated release root, relative to this config file." }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_style": { "$ref": "#/$defs/clientStyle" }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "clientStyle": {
      "type": "string",
      "enum": ["namespaced", "flat"],
      "default": "namespaced",
      "description": "Namespaced resource client or direct operation methods."
    },
    "secret": {
      "description": "Literal value, environment-variable reference, or named Kaji auth profile. Prefer an environment or profile reference for credentials.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["env"],
          "properties": { "env": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile"],
          "properties": { "profile": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "remoteInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri", "description": "Remote OpenAPI URL." },
        "headers": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/secret" },
          "description": "Headers sent while downloading the OpenAPI document."
        },
        "auth": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "username", "password"],
              "properties": {
                "type": { "const": "basic" },
                "username": { "$ref": "#/$defs/secret" },
                "password": { "$ref": "#/$defs/secret" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "token"],
              "properties": {
                "type": { "const": "bearer" },
                "token": { "$ref": "#/$defs/secret" }
              }
            }
          ]
        }
      }
    },
    "openapi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": {
          "description": "Local OpenAPI YAML/JSON file or a remote OpenAPI request.",
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "$ref": "#/$defs/remoteInput" }
          ]
        },
        "artifacts": { "type": "string", "minLength": 1, "description": "Existing Kaji compiler artifact directory." },
        "name": { "type": "string", "default": "API" },
        "version": { "type": "string", "default": "0.1.0" },
        "compiler": { "type": "string", "description": "Optional replacement kaji-openapi executable." },
        "paths": { "$ref": "#/$defs/pathSelection" }
      },
      "oneOf": [
        { "required": ["input"], "not": { "required": ["artifacts"] } },
        { "required": ["artifacts"], "not": { "required": ["input"] } }
      ]
    },
    "pathSelection": {
      "type": "object",
      "additionalProperties": false,
      "description": "Select a focused API surface before every package is generated. Include patterns are ORed; excludes always win. Patterns use * for any sequence, including /, and ? for one character.",
      "properties": {
        "include": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/" },
          "description": "Only generate operations whose OpenAPI path matches one of these patterns. Empty means every path."
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/" },
          "description": "Never generate operations whose OpenAPI path matches one of these patterns."
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "path", "plugins"],
      "properties": {
        "language": {
          "type": "string",
          "enum": ["typescript", "typescript-cli", "rust", "rust-cli", "go", "python", "php", "java", "csharp", "dotnet", "elixir", "ruby", "swift", "mock", "artifacts"]
        },
        "path": { "type": "string", "minLength": 1, "description": "Safe path below output.path." },
        "name": { "type": "string", "minLength": 1, "description": "Generated package identity." },
        "client_style": { "$ref": "#/$defs/clientStyle" },
        "plugins": { "type": "array", "items": { "$ref": "#/$defs/plugin" } }
      }
    },
    "plugin": {
      "anyOf": [
        { "$ref": "#/$defs/sdkPlugin" },
        { "$ref": "#/$defs/typescriptCliPlugin" },
        { "$ref": "#/$defs/rustCliPlugin" },
        { "$ref": "#/$defs/typescriptArtifactPlugin" },
        { "$ref": "#/$defs/redocPlugin" },
        { "$ref": "#/$defs/mcpPlugin" },
        { "$ref": "#/$defs/mockPlugin" }
      ]
    },
    "sdkPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "const": "sdk" },
        "transport": { "type": "string", "enum": ["fetch", "axios"], "default": "fetch" },
        "surface": { "type": "string", "enum": ["client", "raw"], "default": "client" },
        "client_name": { "type": "string", "minLength": 1 },
        "group_by_tag": { "type": "boolean", "default": true },
        "throw_on_error": { "type": "boolean", "default": true },
        "jobs": { "type": "integer", "minimum": 1, "description": "Go generation worker count." }
      }
    },
    "typescriptArtifactPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "enum": ["zod", "tanstack-react-query", "tanstack-vue-query", "swr", "faker", "msw", "cypress"] },
        "output": { "type": "string", "minLength": 1 },
        "clients_import": { "type": "string", "minLength": 1 },
        "group_by_tag": { "type": "boolean", "default": true }
      }
    },
    "typescriptCliPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "const": "cli" },
        "command_name": { "type": "string", "minLength": 1, "description": "Executable command name. Defaults to the API name." },
        "base_url": { "type": "string", "format": "uri", "description": "Default API origin. Users can override it with --base-url or the generated environment variable." },
        "oauth": { "$ref": "#/$defs/cliOAuth" }
      }
    },
    "rustCliPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "const": "cli" },
        "command_name": { "type": "string", "minLength": 1, "description": "Executable command name. Defaults to the API name." },
        "base_url": { "type": "string", "format": "uri", "description": "Default API origin. Users can override it with --base-url or the generated environment variable." }
      }
    },
    "cliOAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id"],
      "properties": {
        "client_id": { "type": "string", "minLength": 1, "description": "Public OAuth client identifier registered for this CLI." },
        "security_scheme": { "type": "string", "minLength": 1, "description": "OpenAPI OAuth security scheme used by access tokens." },
        "scopes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "preferred_flow": { "type": "string", "enum": ["device", "browser"], "default": "device" },
        "authorization_url": { "type": "string", "format": "uri", "description": "Overrides the OpenAPI authorizationCode flow URL." },
        "device_authorization_url": { "type": "string", "format": "uri", "description": "RFC 8628 device authorization endpoint." },
        "token_url": { "type": "string", "format": "uri", "description": "Overrides the OpenAPI OAuth token URL." },
        "redirect_uri": { "type": "string", "format": "uri", "description": "Registered loopback callback for PKCE browser login." }
      }
    },
    "redocPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "const": "redoc" },
        "output": { "type": "string", "minLength": 1 },
        "openapi_spec": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "mcpPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "const": "mcp" },
        "output": { "type": "string", "minLength": 1 }
      }
    },
    "mockPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "const": "server" },
        "image": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    }
  }
}
